	CASE 9
		sAbout '= "Lubrication: how wet she is; wetter makes insertion easier"
	CASE 10
		sAbout '= "Willingness to go along with you"
	CASE 11
		sAbout '= "Sexual desire, lust"
	CASE 12
		sAbout '= "Giving in to you"
	CASE 13
		sAbout '= "Technique picked up from what you do"
	CASE 14
		sAbout '= "Embarrassment"
	CASE 15
