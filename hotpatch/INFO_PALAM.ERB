#DIM DYNAMIC nPalam
#DIMS DYNAMIC sAbout
SELECTCASE nPalam
	CASE 0
		sAbout '= "Clitoral (or penile) pleasure"
	CASE 1
		sAbout '= "Vaginal pleasure"
	CASE 2
		sAbout '= "Anal pleasure"
	CASE 3
		sAbout '= "Breast pleasure"
	CASE 4
