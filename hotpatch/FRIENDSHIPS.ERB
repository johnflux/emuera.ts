; CFLAG 7399 is history ONLY: nonzero means the one-time favor bonus was received.
; It never determines current friendship. Legacy -1 values also mean bonus received.
@HOTPATCH_FRIENDSHIP_BONUS_RECEIVED(nChara)
#FUNCTION
#DIM DYNAMIC nChara
RETURNF CFLAG:nChara:7399 != 0

@HOTPATCH_FRIENDSHIP_DISLIKE(nChara)
#FUNCTION
#DIM DYNAMIC nChara
RETURNF BASE:nChara:怒り > 0 || CFLAG:nChara:不機嫌 || CFLAG:nChara:ブチギレ || MARK:nChara:反発刻印 || (RELATION:nChara:(NO:MASTER) != 0 && RELATION:nChara:(NO:MASTER) < 60) || CFLAG:nChara:好感度 < -50 || CFLAG:nChara:信頼度 < -50

@HOTPATCH_FRIENDSHIP_ACTIVE(nChara)
#FUNCTION
#DIM DYNAMIC nChara
RETURNF CFLAG:nChara:好感度 >= 500

@HOTPATCH_FRIENDSHIP_REASON(nChara)
#FUNCTIONS
#DIM DYNAMIC nChara
SIF HOTPATCH_FRIENDSHIP_ACTIVE(nChara)
	RETURNF "You are already friends."
SIF CFLAG:nChara:好感度 >= 400 || ABL:nChara:親密 >= 5
	RETURNF ""
SIF HOTPATCH_FRIENDSHIP_DISLIKE(nChara)
	RETURNF "They do not like you right now. Resolve their anger, resentment or dislike first."
SIF CFLAG:nChara:好感度 < 0 || CFLAG:nChara:信頼度 < 0
	RETURNF "They do not really know you yet."
SIF HOTPATCH_FRIENDSHIP_SCORE(nChara) < 200
	RETURNF "They would like to know you a bit better first."
RETURNF ""

@HOTPATCH_FRIENDSHIP_SCORE(nChara)
#FUNCTION
#DIM DYNAMIC nChara
#DIM DYNAMIC nScore
nScore = CFLAG:nChara:好感度 + CFLAG:nChara:信頼度
SIF TALENT:nChara:陽気／陰気 == 1
	nScore += 100
SIF TALENT:MASTER:魅力
	nScore += 100
SIF TALENT:nChara:一線越えない
	nScore -= 100
SIF TALENT:nChara:性別嗜好 == 3
	nScore -= 100
RETURNF nScore

@HOTPATCH_FRIENDSHIP_DETAILS(nChara)
#FUNCTIONS
#DIM DYNAMIC nChara
#DIMS DYNAMIC sResult
sResult '= @"Favor {CFLAG:nChara:好感度} + trust {CFLAG:nChara:信頼度}"
SIF TALENT:nChara:陽気／陰気 == 1
	sResult += " + 100 (Cheerful)"
SIF TALENT:MASTER:魅力
	sResult += " + 100 (your Charming)"
SIF TALENT:nChara:一線越えない
	sResult += " - 100 (Reserved)"
SIF TALENT:nChara:性別嗜好 == 3
	sResult += " - 100 (Misanthrope / distrustful)"
RETURNF sResult + @" = {HOTPATCH_FRIENDSHIP_SCORE(nChara)}; required: 200."

@HOTPATCH_FRIENDSHIP_PREVIEW(nChara)
#DIM DYNAMIC nChara
#DIMS DYNAMIC sReason
sReason '= HOTPATCH_FRIENDSHIP_REASON(nChara)
HTML_PRINT @"<p class='era-friendship-formula'>%HTML_ESCAPE(HOTPATCH_FRIENDSHIP_DETAILS(nChara))%</p>"
HTML_PRINT "<p>Score = favor + trust + 100 if Cheerful + 100 if you are Charming - 100 if Reserved - 100 if Misanthrope (distrustful). Required below both 400 favor and Intimacy 5: at least 200.</p>"
HTML_PRINT "<p>Below both 400 favor and Intimacy 5: anger, a hate mark, active dislike (affinity below 60%, excluding the unset neutral value), favor below -50 or trust below -50 blocks acceptance. Otherwise, negative favor or trust means they do not really know you yet; with both nonnegative, the score must be at least 200.</p>"
HTML_PRINT "<p>At 400 favor or Intimacy 5, an eligible introduction happens automatically without the score requirement or a confirmation prompt. Current friendship depends only on favor being at least 500. First acceptance, including automatic recognition, gives +100 favor and up to +2 Intimacy toward level 5 once, preserving higher levels; the saved marker records only that bonus history.</p>"
IF STRLENS(sReason)
	HTML_PRINT @"<p class='era-relationship-error'>Current answer: %HTML_ESCAPE(sReason)%</p>"
ELSE
	HTML_PRINT "<p>Current answer: they will agree to be friends.</p>"
ENDIF

@HOTPATCH_FRIENDSHIP_ACCEPT(nChara)
#DIM DYNAMIC nChara
#DIM DYNAMIC nBonus
nBonus = !HOTPATCH_FRIENDSHIP_BONUS_RECEIVED(nChara)
CFLAG:nChara:7399 = 1
IF nBonus
	CFLAG:nChara:好感度 += 100
	ABL:nChara:親密 = MAX(ABL:nChara:親密, MIN(ABL:nChara:親密 + 2, 5))
	PRINTFORML %CALLNAME:nChara% accepts your friendship introduction. Favor +100. Intimacy: {ABL:nChara:親密}.
ELSE
	PRINTFORML %CALLNAME:nChara% accepts your friendship introduction. The introduction bonus has already been received.
ENDIF
RETURN 1

@HOTPATCH_FRIENDSHIP_SYNC
#DIM DYNAMIC nChara
FOR nChara, 0, CHARANUM
	SIF nChara == MASTER
		CONTINUE
	IF !HOTPATCH_FRIENDSHIP_BONUS_RECEIVED(nChara) && HOTPATCH_FRIENDSHIP_ACTIVE(nChara)
		CALL HOTPATCH_FRIENDSHIP_ACCEPT(nChara)
	ENDIF
NEXT

@HOTPATCH_FRIENDSHIP_OFFER
#DIMS DYNAMIC sReason
SIF HOTPATCH_FRIENDSHIP_BONUS_RECEIVED(TARGET) || (CFLAG:TARGET:好感度 < 400 && ABL:TARGET:親密 < 5) || HOTPATCH_FRIENDSHIP_ACTIVE(TARGET)
	RETURN 0
sReason '= HOTPATCH_RELATIONSHIP_REASON(8, TARGET)
SIF STRLENS(sReason)
	RETURN 0
sReason '= HOTPATCH_FRIENDSHIP_REASON(TARGET)
SIF STRLENS(sReason)
	RETURN 0
CALL HOTPATCH_FRIENDSHIP_ACCEPT(TARGET)
RETURN 1
