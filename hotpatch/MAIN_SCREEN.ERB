SIF MARK:nChara:反発刻印 > 0
	sHtml += @"<span class='era-feel era-feel-hate' title='Hate Mark level {MARK:nChara:反発刻印} of 3'>Hate Lv{MARK:nChara:反発刻印}</span>"
IF CFLAG:nChara:ブチギレ && !CFLAG:nChara:睡眠
	sHtml += TALENT:nChara:度胸 < 0 ? "<span class='era-feel era-feel-sad'>Sad</span>" # "<span class='era-feel era-feel-mad'>Mad</span>"
ELSEIF bTab && TALENT:nChara:機嫌 == -1
	sHtml += "<span class='era-feel era-feel-sullen'>Sullen</span>"
ENDIF
SIF bTab && TALENT:nChara:機嫌 == 1
	sHtml += "<span class='era-feel era-feel-happy'>Happy</span>"

RETURNF sHtml
