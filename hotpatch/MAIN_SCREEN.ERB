;-------------------------------------------------------------------------------
; Hotpatch for the main screen's status (ERB/ステータス表示関連/INFO.ERB @SHOW_STATUS). Together with
; MAIN_SCREEN_COMMANDS.ERB (@SHOW_USERCOM) it lays the screen out in panels (<era-open>/<era-close> boxes, see
; docs/hotpatches.md): a header with the clock, date, place and a large Time Stop button; the room occupants and the
; target's stats on the left; the selected character's card (with the look text: clothes and what is happening to
; them) in the middle; your card on the right; the actions below.
;
; SHOW_STATUS's logic up to the display is copied unchanged. The display calls the game's own printers for the
; date, weather, situation, place, states and counters, and HOTPATCH_* rewrites of INFO_TARGET_BUTTON, INFO_BASE,
; INFO_EMOTION, INFO_TARGET_SITUATION and INFO_TIMESTOP that keep their rules and side effects (TFLAG:102,
; TFLAG:パンツ収奪, 押し倒され) but print HTML. Dropped: the clock's line-wrapping width, the [Status] collapse
; toggle [3001] (always expanded) and [Abilities Display] [803] (now the "See more" button on your card).
;-------------------------------------------------------------------------------
@SHOW_STATUS
#DIM 天気非表示
#DIM 元の天気
VARSET LOCAL
INFO_LINECOUNT = LINECOUNT
IF STR:(8000 + (CFLAG:MASTER:現在位置)) == "" && AT_HOME(MASTER)
	PRINTFORML The current position is invalid.（Currently＞{CFLAG:MASTER:現在位置}）
	PRINTFORMW To avoid errors, you will be moved to %NAME_FROM_PLACE(CFLAG:MASTER:初期位置)%.
	CFLAG:MASTER:現在位置 = CFLAG:MASTER:初期位置
	CFLAG:MASTER:デート中 = MAIN_MAP
ENDIF
;Custom code, resets the used words array
VARSET USED_WORDS
USED_WORDS_I = 0

nMoveAsked = 0 ;addition custom code, reset flag that prevents spam in case target goes out both to work and outside
;-------------------------------------------------
;TFLAG:調教中COMABLE管理表示制御
;-------------------------------------------------
TFLAG:調教中COMABLE管理 = TFLAG:調教自動実行管理
SIF TFLAG:調教自動実行管理 == 1
	TFLAG:調教中COMABLE管理 = 0
SIF TFLAG:調教自動実行管理
	TFLAG:調教自動実行管理 --
;ウフフ中なら接触部位表示
SIF TFLAG:102 == 2
	CALL SHOW_TOUCH

;-------------------------------------------------
;料理の時間経過
;-------------------------------------------------
SIF DISH_NAME != ""
	CALL DISH_FRESHNESS
;-------------------------------------------------
;畑の時間経過
;-------------------------------------------------
SIF TIME:5 >= 4
	FLAG:803 = 0
	FLAG:807 = 0

;-------------------------------------------------
;キャラの態度
;-------------------------------------------------
CALL CHARA_ATTITUDE

;-------------------------------------------------
;キャラの思考
;-------------------------------------------------
;CALL CHARA_MIND

;-------------------------------------------------
;時間経過、キャラの移動
;-------------------------------------------------
CALL INFO_TIME_PASSING

;-------------------------------------------------
;デート終了タイムアップ処理
;-------------------------------------------------
SIF CHK_DATENOW(CFLAG:MASTER:デート中)
	CALL デート終了タイムアップ処理
;-------------------------------------------------
;TARGET関連のキャラ変数の更新
;-------------------------------------------------
CALL INFO_RENEW_TARGET

;-------------------------------------------------
;ウフフ終了TEQUIP処理
;EQUIPの更新もここに仕込んでおく
;-------------------------------------------------
CALL INFO_RENEW_EQUIP

;-------------------------------------------------
;MASTERの同行フラグチェック
;-------------------------------------------------
SIF !同行人数()
	CFLAG:MASTER:同行 = 0

;-------------------------------------------------
;背景色設定
;-------------------------------------------------
IF FLAG:時間停止
	SETBGCOLOR 1, 24, 60
ELSE
	;(天候パッチ)時刻・天候に応じて背景色を変更
	CALL SET_MAP_WEATHER_BGCOLOR
ENDIF

;-------------------------------------------------
;情報表示
;-------------------------------------------------
PRINTL
;天気の表示/非表示の更新
;天界への行き来の際の天気の更新
CALL INFO_CULC_WEATHER(天気非表示)

;「一日が終わりました」表示と宴会関連の更新処理など
CALL INFO_GO_NEXTDAY
CALL CHANGE_TIMEZONE

;子供の描写
CALL CHILD_DESCRIPTION

;帰宅時間等の予告通知
CALL TIMEUP_NOTICE(FLAG:デート相手)

IF MOREDATE
	FOR LOCAL, 0, NumberOfDates
		SIF LOCAL != FLAG:デート相手 ;don't call it twice
			CALL TIMEUP_NOTICE(Datees:LOCAL)
	NEXT
ENDIF
;-------------------------------------------------
;情報表示 (hotpatch: the display below is laid out in panels)
;-------------------------------------------------
HTML_PRINT "<era-open class='era-layout era-main'>"
HTML_PRINT "<era-open class='era-main-header'>"
CALL HOTPATCH_SKY(天気非表示)
HTML_PRINT @"<div class='era-clock'><img src='%GET_CLOCK_IMAGE_NAME(TIME)%' height='72px'></div>"
HTML_PRINT "<era-open class='era-main-when'>"
CALL INFO_TIME_WATCH
SIF !天気非表示
	CALL INFO_SHOW_WEATHER
CALL INFO_現在の気温
PRINTPLAIN
CALL HOTPATCH_SITUATION
HTML_PRINT "<era-close>"
CALL HOTPATCH_TIMESTOP
HTML_PRINT "<era-close>"

VARSET LOCAL
CALL HOTPATCH_TARGET_DATAGROUP

HTML_PRINT "<era-open class='era-main-occupants'>"
CALL HOTPATCH_OCCUPANTS
HTML_PRINT "<era-close>"
HTML_PRINT "<era-open class='era-main-left'>"
IF TARGET > 0
	HTML_PRINT "<era-open class='era-card era-stats'>"
	HTML_PRINT @"<div class='era-card-title'>%HTML_ESCAPE(CALLNAME:TARGET)%'s Stats</div>"
	CALL SHOW_INFO_PALAM
	HTML_PRINT "<era-close>"
ENDIF
HTML_PRINT "<era-close>"

HTML_PRINT "<era-open class='era-main-center'>"
IF TARGET > 0
	HTML_PRINT "<era-open class='era-card era-character'>"
	CALL HOTPATCH_PLACE
	HTML_PRINT "<era-open class='era-scene'>"
	CALL HOTPATCH_SCENE
	HTML_PRINT "<era-close>"
	HTML_PRINT "<era-open class='era-portrait'>"
	CALL HOTPATCH_PORTRAIT
	HTML_PRINT "<era-close>"
	HTML_PRINT "<era-open class='era-character-info'>"
	CALL HOTPATCH_TARGET_SITUATION(FLAG:TARGETの情報表示モード)
	CALL HOTPATCH_BASE(TARGET)
	CALL HOTPATCH_EMOTION
	LOCALS '= HOTPATCH_STAINS(TARGET)
	SIF STRLENS(LOCALS)
		HTML_PRINT @"<div class='era-player-status era-stains'><span class='era-status-label'>Stains:</span>%LOCALS%</div>"
	CALL HOTPATCH_TARGET_STATUS
	CALL SHOW_EQUIP_1
	HTML_PRINT "<era-open class='era-look'>"
	CALL HOTPATCH_LOOK
	HTML_PRINT "<era-close>"
	HTML_PRINT "<era-close>"
	HTML_PRINT "<era-close>"
ELSE
	HTML_PRINT "<era-open class='era-card era-character era-alone'>"
	CALL HOTPATCH_PLACE
	HTML_PRINT "<era-open class='era-scene'>"
	CALL HOTPATCH_SCENE
	HTML_PRINT "<era-close>"
	HTML_PRINT "<div class='era-alone-message'><span class='era-alone-mark'></span><span class='era-alone-title'>Nobody else is here</span><span class='era-alone-hint'>Move or go out to find someone, or wait for visitors.</span></div>"
	CALL SHOW_EQUIP_1
	HTML_PRINT "<era-close>"
ENDIF
HTML_PRINT "<era-close>"

HTML_PRINT "<era-open class='era-main-right'>"
HTML_PRINT "<era-open class='era-card era-player'>"
LOCALS '= "Funds" + COND_STR(@"&#10;Charisma: %DIGIT_GROUP(MONEY:2)% CM", MONEY:2) + COND_STR(@"&#10;Bullet Money: %DIGIT_GROUP(MONEY:弾貨)% BM", MONEY:弾貨)
HTML_PRINT @"<div class='era-card-title'>%HTML_ESCAPE(CALLNAME:MASTER)%<span class='era-sub'>You</span><button value='803' class='era-see-more' title='Abilities, experience, personal info and more, for you and everyone here'>See more</button><span class='era-funds' title='%LOCALS%'>%HTML_ESCAPE(金額表示(MONEY))%</span></div>"
HTML_PRINT HOTPATCH_PLAYER_KIND()
CALL HOTPATCH_BASE(MASTER)
CALL HOTPATCH_PLAYER_STATUS
CALL SHOW_EQUIP_SP
CALL SHOW_EQUIP_3
CALL INFO_GAUGEGROUP
HTML_PRINT "<era-close>"
HTML_PRINT "<era-close>"

IF !TARGET && TFLAG:抱きつきモード
	TFLAG:抱きつきモード = 0
	TFLAG:102 = 1
ENDIF

IF CFLAG:MASTER:うふふ == 2
	HTML_PRINT "<era-open class='era-card era-counters'>"
	CALL カウンター呼び出し処理
	HTML_PRINT "<era-close>"
ENDIF
; The layout stays open for SHOW_USERCOM (hotpatch/MAIN_SCREEN_COMMANDS.ERB), which closes it.
SIF REFRESH_STATUS() ;Custom code, cycle again if nRefreshStatus is set to 1.
	RESTART

;-------------------------------------------------------------------------------
; INFO_TARGET_DATAGROUP without its display: the display moved to the occupant list and the character card.
;-------------------------------------------------------------------------------
;-------------------------------------------------------------------------------
; The player card's race and body size (TALENT 体型: the race talents and size names of the sheet's Personality
; section, where a normal size has no name). Sizes other than normal are highlighted.
;-------------------------------------------------------------------------------
@HOTPATCH_PLAYER_KIND()
#FUNCTIONS
#DIMS DYNAMIC sRace
#DIMS DYNAMIC sSize
sRace '= GET_CHARA_TALENT_BY_CATEGORY_TR(MASTER, "RACE")
sRace '= REPLACE(sRace, "＠$", "")
sRace '= REPLACE(sRace, "＠", " · ")
sSize '= GET_TALENTNAME_TR(GETNUM(TALENT, "体型"), TALENT:MASTER:体型)
IF STRLENS(sSize)
	sSize '= @"<span class='era-size era-unusual' title='Body size; a mallet can change it'>%HTML_ESCAPE(sSize)%</span>"
ELSE
	sSize '= "<span class='era-size' title='Body size; a mallet can change it'>Normal size</span>"
ENDIF
SIF STRLENS(sRace)
	sRace '= @"<span class='era-player-race'>%HTML_ESCAPE(sRace)%</span><span class='era-sep'> · </span>"
RETURNF @"<div class='era-player-kind'>%sRace%%sSize%</div>"

@HOTPATCH_TARGET_DATAGROUP
IF TARGET <= 0
	TFLAG:102 = 0
	TFLAG:パンツ収奪 = 0
	RETURN
ENDIF
IF !CFLAG:睡眠
	CALL 押し倒され
ELSEIF CFLAG:イタズラ <= 1
	;うふふ解除
	CVARSET CFLAG, GETNUM(CFLAG, "うふふ"), 0
ENDIF
IF CFLAG:睡眠
	IF CFLAG:イタズラ == 1
		TFLAG:102 = 1
	ELSEIF CFLAG:イタズラ == 2
		CFLAG:TARGET:うふふ = 1
		CFLAG:MASTER:うふふ = 1
		TFLAG:102 = 2
	ELSE
		TFLAG:102 = 0
	ENDIF
ENDIF

;-------------------------------------------------------------------------------
; INFO_TARGET_BUTTON as a list: companions, the carried character and everyone in the room, each a button
; (1000 + character) with a face, name and state. Counts TFLAG:パンツ収奪 as the original does.
;-------------------------------------------------------------------------------
@HOTPATCH_OCCUPANTS
#DIM DYNAMIC nIndex
#DIM DYNAMIC nChara
#DIM DYNAMIC nCount
#DIM DYNAMIC nColor
#DIMS DYNAMIC sItems
#DIMS DYNAMIC sClass
#DIMS DYNAMIC sState
TFLAG:パンツ収奪 = 0
IF TARGET > 0
	FOR nIndex, 1, GET_TARGETNUM() + 1
		nChara = TARGET:nIndex
		SIF nChara <= 0
			CONTINUE
		sClass '= ""
		IF CFLAG:nChara:同行
			IF !CHK_DATENOW(CFLAG:MASTER:デート中)
				sState '= "Accompanying you"
			ELSEIF TFLAG:泡風呂
				sState '= "Giving service"
			ELSE
				sState '= "Dating"
			ENDIF
			sClass += " era-companion"
		ELSEIF TFLAG:運搬 == nChara
			sState '= "Being carried"
		ELSEIF CFLAG:nChara:現在位置 != CFLAG:MASTER:現在位置
			CONTINUE
		ELSE
			sState '= ""
			RESETCOLOR
			CALL QoL_HighlightRequestChara(nChara)
			nColor = GETCOLOR()
			RESETCOLOR
			IF nColor != GETCOLOR()
				sState '= "Has a request"
				sClass += " era-request"
			ENDIF
			SIF FLAG:70 == 1 && EQUIP:nChara:0 && EQUIP:nChara:下半身下着２ != 0 && FLAG:700 >= 100 && GET_INT(nChara, "下半身下着_ずらし可能", EQUIP:nChara:下半身下着２, "コレクション表示可能")
				TFLAG:パンツ収奪++
		ENDIF
		IF CFLAG:nChara:睡眠
			sState '= STRLENS(sState) ? sState + " · Asleep" # "Asleep"
			sClass += " era-asleep"
		ENDIF
		SIF !STRLENS(sState)
			sState '= @"Favor %HOTPATCH_RANK(CFLAG:nChara:2, "MAX_50000")%"
		sState += HOTPATCH_FEELINGS(nChara, 1)
		SIF nChara == TARGET
			sClass += " era-selected"
		sClass += HOTPATCH_MOOD_CLASS(nChara)
		CALL HOTPATCH_FACE(nChara)
		sItems += @"<button value='{1000 + nChara}' class='era-occupant%sClass%'><span class='era-face'>%RESULTS%</span>"
		sItems += @"<span class='era-occupant-text'><span class='era-occupant-name'>%HTML_ESCAPE(CALLNAME:nChara)%</span>"
		sItems += @"<span class='era-occupant-state'>%sState%</span></span></button>"
		nCount++
	NEXT
	IF TFLAG:運搬 > 0 && FINDELEMENT(TARGET, TFLAG:運搬, 1) == -1
		CALL HOTPATCH_FACE(TFLAG:運搬)
		sItems += @"<span class='era-occupant'><span class='era-face'>%RESULTS%</span><span class='era-occupant-text'>"
		sItems += @"<span class='era-occupant-name'>%HTML_ESCAPE(CALLNAME:(TFLAG:運搬))%</span><span class='era-occupant-state'>Being carried</span></span></span>"
		nCount++
	ENDIF
ENDIF
SIF !nCount
	sItems '= "<span class='era-occupant era-occupant-none'><span class='era-face'></span><span class='era-occupant-text'><span class='era-occupant-name'>Just you</span><span class='era-occupant-state'>No one else is in the room</span></span></span>"
HTML_PRINT @"<div class='era-card era-occupants'><div class='era-card-title'>Room Occupants</div><div class='era-occupant-list'>%sItems%</div></div>"

; The character's face picture as an <img> in RESULTS (empty if the game has none), as LOAD_FACE_IMAGE gets it.
@HOTPATCH_FACE(nChara)
#DIM DYNAMIC nChara
IF TALENT:nChara:行きずり && !GCREATED(CFLAG:nChara:モブ子素材CFLAG開始位置)
	CALL モブ子生成(nChara, 0)
	CALL モブ子生成(nChara, 1)
ENDIF
RESULT = 0
CALL GET_BASE_RESOURCE(nChara, "顔絵", "服", "通常")
SIF !RESULT || RESULT > 1
	RESULTS = %GET_BASESTYLE(nChara, "顔絵")%_服_通常_{NO:nChara}
IF SPRITECREATED(RESULTS)
	RESULTS '= @"<img src='%RESULTS%' height='44px'>"
ELSE
	RESULTS '= @"<span class='era-face-letter'>%HTML_ESCAPE(SUBSTRINGU(CALLNAME:nChara, 0, 1))%</span>"
ENDIF

; The current target's picture (with its effect layers) from PRINT_TARGET_IMAGE, whatever the image settings.
@HOTPATCH_PORTRAIT
#DIM DYNAMIC nShown
#DIM DYNAMIC nSettings
#DIM DYNAMIC nSize
nShown = FLAG:画像表示
nSettings = FLAG:画像表示設定
nSize = isModifier
FLAG:画像表示 = 1
FLAG:画像表示設定 = 0
;A little larger than the game's image size setting, so it fills the card's corner.
isModifier += 20
CALL PRINT_TARGET_IMAGE(TARGET)
FLAG:画像表示 = nShown
FLAG:画像表示設定 = nSettings
isModifier = nSize

;-------------------------------------------------------------------------------
; INFO_TARGET_SITUATION: the target's state (SHOW_EQUIP_2), relationship and anger or sleep.
;-------------------------------------------------------------------------------
@HOTPATCH_TARGET_SITUATION(情報表示MODE = 0)
#DIM 情報表示MODE ;0 = 全部ON, 1 = 簡易
#DIMS DYNAMIC sHtml
HTML_PRINT "<era-open class='era-character-state'>"
CALL SHOW_EQUIP_2
;Species after the name (the game's own race text and description, as in its talent list).
sHtml '= PRINT_GET_RACE(TARGET)
IF STRLENS(sHtml)
	HTML_PRINT @"<span class='era-race' title='%HTML_ESCAPE(RACE_INFO(TARGET))%'>%HTML_ESCAPE(sHtml)%</span>"
ELSE
	PRINTL
ENDIF
HTML_PRINT "<era-close>"
sHtml '= @"<span class='era-fact'><span class='era-fact-label'>Favor</span>%HOTPATCH_RANK(CFLAG:2, "MAX_50000")% {CFLAG:2}</span>"
sHtml += @"<span class='era-fact'><span class='era-fact-label'>Trust</span>%HOTPATCH_RANK(CFLAG:信頼度, "MAX_20000")% {CFLAG:信頼度}</span>"
SIF NOTICE_LUST(TARGET)
	sHtml += @"<span class='era-fact'><span class='era-fact-label'>Frustration</span>{CFLAG:TARGET:溜まってる度 / 10}%</span>"
IF 情報表示MODE == 0
	sHtml += @"<span class='era-fact'><span class='era-fact-label'>Children</span>{CFLAG:TARGET:子供人数}</span>"
	IF (!FLAG:CHILD_LIMIT_BYPASS && INRANGE(CFLAG:TARGET:出産経過日, 1, 59)) || TALENT:TARGET:妊娠 ;1で種付け不可
		sHtml += "<span class='era-fact'><span class='era-fact-label'>Fertile</span>×</span>"
	ELSE
		sHtml += "<span class='era-fact'><span class='era-fact-label'>Fertile</span>〇</span>"
	ENDIF
ENDIF
sHtml += HOTPATCH_FEELINGS(TARGET, 0)
HTML_PRINT @"<div class='era-facts'>%sHtml%</div>"
LOCAL = MIN(BASE:怒り / 200, 5)
SIF BASE:怒り && LOCAL == 0 ;qol custom code, show anger sign if there's even a little bit of anger going
	LOCAL = 1
LOCAL:1 = 1
IF CFLAG:睡眠
	IF CFLAG:ブチギレ
		SETCOLOR 255,0,0
		PRINT Angry
		RESETCOLOR
	ELSEIF CFLAG:MASTER:イタズラ == 2 || (CFLAG:MASTER:イタズラ && TCVAR:TARGET:睡眠薬強度) ;qol custom code, show sleep depth with sleep pills
		SELECTCASE TCVAR:TARGET:睡眠深度
			CASE 0 TO 500
				SETCOLOR 255,0,0
				PRINTFORM Sleep status: Can wake up any moment now
			CASE 501 TO 1500
				SETCOLOR 255,255,0
				PRINTFORM Sleep status: Restless
			CASE 1501 TO 3000
				SETCOLOR 0,255,0
				PRINTFORM Sleep status: Light
			CASE 3001 TO 5000
				SETCOLOR 0,255,255
				PRINTFORM Sleep status: Asleep
			CASE IS > 5000
				SETCOLOR C_BLUE ;custom code, changed color
				PRINTFORM Sleep status: Soundly asleep
			CASEELSE
				LOCAL:1 = 0
		ENDSELECT
		RESETCOLOR
	ELSEIF LOCAL
		PRINTFORM Awoken:%"！" * LOCAL%
	ELSE
		LOCAL:1 = 0
	ENDIF
ELSE
	;Mad (or Sad) is a tag in the facts row (HOTPATCH_FEELINGS), so it takes no line of its own.
	IF CFLAG:ブチギレ
		LOCAL:1 = 0
	ELSEIF CFLAG:イタズラ || TCVAR:泥酔
		IF LOCAL
			PRINTFORM Awoken:%"！" * LOCAL%
		ELSE
			LOCAL:1 = 0
		ENDIF
	ELSE
		;An empty "Anger:" is left out; the anger marks are padded only when sleep resistance follows them.
		SIF LOCAL
			PRINTFORM Anger:%"！" * LOCAL%
		SIF LOCAL && CFLAG:TARGET:眠気覚まし > 0
			PRINTFORM   %"　" * (5 - LOCAL)%
		SELECTCASE CFLAG:TARGET:眠気覚まし
			CASE IS > 240
				PRINT <Sleep Res・Lots>
			CASE IS > 180
				PRINT <Sleep Res・Strong>
			CASE IS > 120
				PRINT <Sleep Res・Middle>
			CASE IS > 0
				PRINT <Sleep Res・Weak>
			CASEELSE
				SIF !LOCAL
					LOCAL:1 = 0
		ENDSELECT
	ENDIF
ENDIF
SIF LOCAL:1
	PRINTL 

; PRINT_RANK as HTML: the rank letter coloured as PRINT_ALPHABET colours it.
@HOTPATCH_RANK(nValue, sScale)
#FUNCTIONS
#DIM DYNAMIC nValue
#DIMS DYNAMIC sScale
#DIM DYNAMIC nRank
#DIMS CONST sRank10, 10 = "Ex", "SS", "S", "A", "B", "C", "D", "E", "F", "G"
#DIMS CONST sTone10, 10 = "purple", "white", "white", "pink", "red", "orange", "yellow", "green", "aqua", "gray"
#DIMS CONST sRank7, 7 = "Ex", "S", "A", "B", "C", "D", "E"
#DIMS CONST sTone7, 7 = "purple", "white", "pink", "red", "orange", "yellow", "gray"
nRank = CALC_RANK_FUNCTION(nValue, sScale)
SIF CALC_RANK_NUM_FUNCTION(nValue, sScale) == 7
	RETURNF @"<span class='era-rank era-tone-%sTone7:nRank%'>%sRank7:nRank%</span>"
RETURNF @"<span class='era-rank era-tone-%sTone10:nRank%'>%sRank10:nRank%</span>"

;-------------------------------------------------------------------------------
; INFO_BASE as meters: true stamina (above the 500 floor), energy, drunkenness, vigour, then the drunk face
; and the erection state (INFO_SHOW_BOKKI). Low stamina and energy warn as BASE_BAR_2 does.
;-------------------------------------------------------------------------------
@HOTPATCH_BASE(nChara)
#DIM DYNAMIC nChara
#DIMS DYNAMIC sHtml
#DIMS DYNAMIC sClass
#DIMS DYNAMIC sState
sClass '= "era-sta"
SIF CFLAG:nChara:睡眠 && nChara != MASTER && !CFLAG:MASTER:313
	sClass += " era-asleep"
sHtml '= HOTPATCH_BAR("Sta", BASE:nChara:0 - 500, MAXBASE:nChara:0 - 500, sClass, "Stamina")
sHtml += HOTPATCH_BAR("Ene", BASE:nChara:気力, MAXBASE:nChara:気力, "era-ene", "Energy")
SIF nGlobalDrunk || BASE:nChara:15 ; ATW qol: option to hide the drunk bar if sober
	sHtml += HOTPATCH_BAR("Drnk", BASE:nChara:酒気, MAXBASE:nChara:酒気, "era-drnk", "Drunkenness")
SIF HAS_PENIS(nChara)
	sHtml += HOTPATCH_BAR("Vig", BASE:nChara:精力, MAXBASE:nChara:精力, "era-vig", "Vigor")
sState '= ALCOHOL_FACE_TR(nChara)
SIF STRLENS(sState)
	sState '= @"<span class='era-chip era-drunk'>%HTML_ESCAPE(sState)%</span>"
; Your own arousal is on your Status line (HOTPATCH_PLAYER_STATUS).
IF HAS_PENIS(nChara) && nChara != MASTER
	IF BASE:nChara:勃起 >= 1500 ;qol custom code, account for unmatched
		sState += "<span class='era-chip era-erect era-strong'><span class='era-chip-label'>Arousal</span>Erection!!</span>"
	ELSEIF BASE:nChara:勃起 >= 1000
		sState += "<span class='era-chip era-erect'><span class='era-chip-label'>Arousal</span>Hard</span>"
	ELSEIF BASE:nChara:勃起 >= 500
		sState += "<span class='era-chip era-erect'><span class='era-chip-label'>Arousal</span>Soft</span>"
	ENDIF
ENDIF
SIF STRLENS(sState)
	sHtml += @"<div class='era-chips'>%sState%</div>"
HTML_PRINT @"<div class='era-bars'>%sHtml%</div>"

; One labelled meter row, its tooltip giving the full name; "era-low"/"era-critical" are added below half and a
; quarter for stamina and energy. With bTotal the value is shown against the maximum ("1000 / 1500").
@HOTPATCH_BAR(sLabel, nValue, nMax, sClass, sName, bTotal)
#FUNCTIONS
#DIMS DYNAMIC sLabel
#DIM DYNAMIC nValue
#DIM DYNAMIC nMax
#DIMS DYNAMIC sClass
#DIMS DYNAMIC sName
#DIM DYNAMIC bTotal
nValue = MAX(nValue, 0)
nMax = MAX(nMax, 1)
IF GROUPMATCH(sLabel, "Sta", "Ene")
	IF nValue * 4 < nMax
