;-------------------------------------------------------------------------------
; Your own state as a plain "Status" line under your meters (not chips, so it doesn't read as buttons): arousal
; (INFO_SHOW_BOKKI), hunger and bath (HUNGER, BATHED, in their colours), sleepiness and sleep resistance (from
; QOL_INFO_SITUATION) and your body stains (STAIN_INFO, which replaces the Body Stains [801] command); then the
; Pushdown Guard toggle (-9200, QOL_EXTRA_COMMAND_BUTTONS). Have a Meal and Relax in the Bath are in Go & Manage.
;-------------------------------------------------------------------------------
@HOTPATCH_PLAYER_STATUS
#DIMS DYNAMIC sHtml
#DIMS DYNAMIC sText
IF HAS_PENIS(MASTER)
	IF BASE:MASTER:勃起 >= 1500
		sHtml '= HOTPATCH_STATUS_ITEM("Erection!!", 0xFF6AC8, "Arousal: at its peak")
	ELSEIF BASE:MASTER:勃起 >= 1000
		sHtml '= HOTPATCH_STATUS_ITEM("Hard", 0xFF9AD8, "Arousal: hard")
	ELSEIF BASE:MASTER:勃起 >= 500
		sHtml '= HOTPATCH_STATUS_ITEM("Soft", 0xD8A8C8, "Arousal: half hard")
	ENDIF
ENDIF
RESETCOLOR
sText '= HUNGER(MASTER)
sHtml += HOTPATCH_STATUS_ITEM(sText, GETCOLOR(), (sText == "Can eat" ? "Hungry: you can eat again (Have a Meal, in Go &amp; Manage, when you have a dish)" # "Hunger: you ate recently"))
RESETCOLOR
sText '= BATHED(MASTER)
sHtml += HOTPATCH_STATUS_ITEM(sText, GETCOLOR(), (sText == "Can bathe" ? "It has been a while since your last bath (Relax in the Bath, in Go &amp; Manage, where there is one)" # "Since your last bath"))
RESETCOLOR
IF CFLAG:MASTER:デート中 != MAIN_MAP && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	SELECTCASE NEMUKE()
		CASE IS > 690
			sHtml += HOTPATCH_STATUS_ITEM("About to leave", C_D_ORANGE, "Sleepiness")
		CASE IS > 660
			sHtml += HOTPATCH_STATUS_ITEM("Very tired", C_YELLOW, "Sleepiness")
		CASE IS > 600
			sHtml += HOTPATCH_STATUS_ITEM("Tired", C_P_YELLOW, "Sleepiness")
	ENDSELECT
ELSEIF NEMUKE() >= 720
	IF NEMUKE() > 960
		sHtml += HOTPATCH_STATUS_ITEM("Need sleep", C_RED, "Sleepiness")
	ELSEIF NEMUKE() > 840
		sHtml += HOTPATCH_STATUS_ITEM("Sleeping possible", C_YELLOW, "Sleepiness")
	ELSE
		sHtml += HOTPATCH_STATUS_ITEM("Sleeping possible", C_P_YELLOW, "Sleepiness")
	ENDIF
ENDIF
IF CFLAG:MASTER:眠気覚まし
	SELECTCASE CFLAG:MASTER:眠気覚まし
		CASE IS > 240
			sText '= "Lots"
		CASE IS > 180
			sText '= "Strong"
		CASE IS > 120
			sText '= "Middle"
		CASEELSE
			sText '= "Weak"
	ENDSELECT
	sHtml += HOTPATCH_STATUS_ITEM("Sleep resistance: " + sText, GETDEFCOLOR(), "Keeps sleepiness away for a while")
ENDIF
sHtml += HOTPATCH_STAINS(MASTER)
sHtml '= @"<div class='era-player-status'><span class='era-status-label'>Status:</span>%sHtml%</div><div class='era-player-toggles'>"
sHtml += @"<button value='-9200' class='era-toggle%(FLAG:押し倒し ? " era-on" # "")%' title='Pushdown Guard: %(FLAG:押し倒し ? "on" # "off")%&#10;When on, someone only pushes you down if they are stronger than you (fighting ability and build, with shyness, seduction and forwardness); otherwise they just hug you.&#10;When off, anyone in the mood can push you down.'>Pushdown Guard</button>"
HTML_PRINT sHtml + "</div>"

; INFO_CHARA_STAIN as status entries, one per stained body part ("Hands: Semen, Love Juice"). A part's own fluid
; (love juice on the vagina, the penis on itself, the anus on itself), which washing leaves, isn't listed.
@HOTPATCH_STAINS(nChara)
#FUNCTIONS
#DIM DYNAMIC nChara
#DIM DYNAMIC nPart
#DIM DYNAMIC nType
#DIM DYNAMIC nStain
#DIMS DYNAMIC sText
#DIMS DYNAMIC sHtml
#DIMS CONST sPart = "Mouth", "Hands", "Penis", "Vagina", "Anus", "Breasts", "", "", "Armpit"
#DIM CONST nNatural = 0, 0, 2, 1, 8, 0, 0, 0, 0
#DIMS CONST sStain = "Love Juice", "Penis", "Semen", "Anus", "Milk", "Mucus", "Hymen Blood", "Chocolate"
FOR nPart, 0, 9
	SIF nPart == 6 || nPart == 7
		CONTINUE
	SIF nPart == 2 && !(TALENT:nChara:2 & 2)
		CONTINUE
	SIF (nPart == 3 || nPart == 5) && !(TALENT:nChara:2 & 1)
		CONTINUE
	nStain = STAIN:nChara:nPart & ~nNatural:nPart
	SIF !nStain
		CONTINUE
	sText '= ""
	FOR nType, 0, 8
		SIF GETBIT(nStain, nType)
			sText += (STRLENS(sText) ? ", " # "") + sStain:nType
	NEXT
	sHtml += HOTPATCH_STATUS_ITEM(sPart:nPart + ": " + sText, 0xE8B0C8, "Body stains (a bath washes them off)")
NEXT
RETURNF sHtml

