;-------------------------------------------------------------------------------
; The header's backdrop, drawn by CSS from its classes: the sky for the hour (TIME), the weather (TIME:5, abnormal
; weather FLAG:異常気象), the season's land (DAY:2), dimmer under a roof (!OUTROOF), or a cave where the game hides
; the weather (underground); and the area's landmark (HOTPATCH_AREA, web/areas/*.svg, or the pictures for the season
; and time of day in web/areas/<area>/, which app.js picks from these classes). Decoration only: it prints one HTML line.
;-------------------------------------------------------------------------------
@HOTPATCH_SKY(nNoWeather)
#DIM DYNAMIC nNoWeather
#DIM DYNAMIC nHour
#DIMS DYNAMIC sClass
#DIMS CONST sSeason, 5 = "spring", "spring", "summer", "autumn", "winter"
nHour = (TIME / 60) % 24
IF nHour >= 4 && nHour < 6
	sClass '= "era-sky-dawn"
ELSEIF nHour >= 6 && nHour < 10
	sClass '= "era-sky-morning"
ELSEIF nHour >= 10 && nHour < 16
	sClass '= "era-sky-day"
ELSEIF nHour >= 16 && nHour < 19
	sClass '= "era-sky-evening"
ELSE
	sClass '= "era-sky-night"
ENDIF
SELECTCASE TIME:5
	CASE 0
		sClass += " era-weather-clear"
	CASE 1
		sClass += " era-weather-fair"
	CASE 2, 3
		sClass += " era-weather-cloudy"
	CASE 4, 6
		sClass += " era-weather-rain"
	CASE 5, 13, 14, 15
		sClass += " era-weather-storm"
	CASE 7
		sClass += " era-weather-fog"
	CASE 9
		sClass += " era-weather-blizzard"
	CASEELSE
		sClass += " era-weather-snow"
ENDSELECT
SIF FLAG:異常気象
	sClass += " era-weather-strange"
sClass += " era-season-" + sSeason:(LIMIT(DAY:2, 0, 4))
IF nNoWeather
	sClass += " era-underground"
ELSEIF !OUTROOF(CFLAG:MASTER:現在位置)
	sClass += " era-indoor"
ENDIF
SIF HOTPATCH_AREA() >= 0
	sClass += @" era-area-{HOTPATCH_AREA()}"
HTML_PRINT @"<div class='era-sky %sClass%'><span class='era-sky-view'><span class='era-sky-orb'></span><span class='era-sky-clouds'></span><span class='era-sky-landmark'></span><span class='era-sky-fall'></span><span class='era-sky-land'></span></span></div>"

