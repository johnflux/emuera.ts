@HOTPATCH_SETUP_INPUT(nAction)
#DIM DYNAMIC nAction
#DIM DYNAMIC nIndex
#DIM DYNAMIC nChoice
#DIM DYNAMIC nSkip
SELECTCASE nAction
CASE 160000 TO 4279999
	nIndex = (nAction - 160000) / 10000
	nChoice = (nAction - 160000) % 10000
	SIF HOTPATCH_SETUP_NUMBER_LIMIT(nIndex) < 0 || nChoice < HOTPATCH_SETUP_NUMBER_LIMIT(nIndex) || nChoice > HOTPATCH_SETUP_NUMBER_LIMIT(nIndex, 1)
		RETURN 0
	SELECTCASE nIndex
	CASE 0
		MAXBASE:MASTER:体力 = nChoice + 500
		BASE:MASTER:体力 = MAXBASE:MASTER:体力
	CASE 1
		MAXBASE:MASTER:気力 = nChoice
		BASE:MASTER:気力 = nChoice
	CASE 100 TO 158
		SIF CUSTOM_選べない能力(nIndex - 100, MASTER)
			RETURN 0
		ABL:MASTER:(nIndex - 100) = nChoice
	CASE 200 TO 309
		SIF CUSTOM_選べない経験(nIndex - 200, MASTER)
			RETURN 0
		EXP:MASTER:(nIndex - 200) = nChoice
	CASE 400
		FLAG:YANDERE_EVOLVE_CHANCE = nChoice
	CASE 401
		FLAG:YANDERE_SKIP_CHANCE = nChoice
	CASE 402
		FLAG:YANDERE_TIER_2_CHANCE_BONUS = nChoice
	CASE 403 TO 411
		YANDERE_CHANCE:(nIndex - 403) = nChoice
	ENDSELECT
	CALL CHARA_VALIDATE(MASTER)
CASE 140000 TO 150930
	nIndex = (nAction - 140000) / 100
	nChoice = (nAction - 140000) % 100
	IF nIndex > 109 || nChoice > 30 || CUSTOM_選べない経験(nIndex, MASTER)
		RETURN 0
	ENDIF
	EXP:MASTER:nIndex = nChoice
	CALL CHARA_VALIDATE(MASTER)
CASE 130000 TO 130199
	nIndex = nAction - 130000
	IF !FLAG:周回数 || !HOTPATCH_SETUP_IS_RACE(nIndex) || CUSTOM_選べない素質(nIndex, MASTER)
		RETURN 0
	ENDIF
	FOR nChoice, 0, 200
		SIF HOTPATCH_SETUP_IS_RACE(nChoice)
			TALENT:MASTER:nChoice = 0
	NEXT
	TALENT:MASTER:nIndex = nIndex == 197 && !IS_FEMALE(MASTER) ? 2 # 1
	CALL CHARA_VALIDATE(MASTER)
CASE 100000 TO 119999
	nIndex = (nAction - 100000) / 100
	nChoice = (nAction - 100000) % 100 - 10
	IF CUSTOM_選べない素質(nIndex, MASTER) || HOTPATCH_SETUP_BODY_VALUE(nIndex, nChoice) == ""
		RETURN 0
	ENDIF
	SIF HOTPATCH_SETUP_IS_RACE(nIndex) && (!FLAG:周回数 || !TALENT:MASTER:nIndex || nChoice == 0)
		RETURN 0
	TALENT:MASTER:nIndex = nChoice
	CALL CHARA_VALIDATE(MASTER)
CASE 5100 TO 5103
	CALL CUSTOM_BASE(MASTER, nAction - 5100)
CASE 6000 TO 6199
	SIF HOTPATCH_SETUP_IS_RACE(nAction - 6000) && !FLAG:周回数
		RETURN 0
	CALL CUSTOM_TALENT(nAction - 6000, MASTER)
	CALL CHARA_VALIDATE(MASTER)
CASE 7000 TO 7117
	CALL CUSTOM_ABL(200 + nAction - 7000, MASTER)
CASE 8000 TO 8219
	nIndex = (nAction - 8000) / 2
	SIF CUSTOM_選べない経験(nIndex, MASTER)
		RETURN 0
	EXP:MASTER:nIndex = LIMIT(EXP:MASTER:nIndex + (nAction % 2 ? 1 # -1), 0, 30)
	CALL CHARA_VALIDATE(MASTER)
CASE 1000 TO 1011
	nIndex = nAction - 1000
	IF nIndex == 1
		FOR nChoice, 1, CHARANUM
			SIF !IS_NAMED(nChoice) || nChoice == FLAG:なりきり
				CONTINUE
			ニューゲーム特典 '= TOSTR(nChoice)
			BREAK
		NEXT
	ELSE
		ニューゲーム特典 '= HOTPATCH_SETUP_BONUS_VALUE(nIndex)
	ENDIF
CASE 1101 TO 1106, 1108 TO 1110
	CFLAG:MASTER:基本服装セット = nAction - 1100
CASE 1199
	CALL MASTER_CLOTHES_INIT
CASE 1201 TO 1206
	SIF !HAS_PENIS(MASTER)
		RETURN 0
	TALENT:MASTER:形状 = nAction - 1200
CASE 2000 TO 2010
	CALL HOTPATCH_SETUP_HOME(nAction - 2000)
CASE 3000
	CALL RESET_NOUMIN
CASE 30001 TO 39999
	nIndex = nAction - 30000
	IF nIndex >= CHARANUM || nIndex == FLAG:なりきり || !STRLENS(STR_NOUMIN(nIndex, "説明"))
		RETURN 0
	ENDIF
	CALL RESET_NOUMIN
	FLAG:地主 = nIndex
	FLAG:農民難易度 = 1
	FLAG:畑拡張 = 1
	FLAG:地主貸付金 = INT_NOUMIN(nIndex, "報酬") * 1000
	FLAG:年始貸付金 = FLAG:地主貸付金
CASE 3101 TO 3103
	SIF !FLAG:地主
		RETURN 0
	FLAG:農民難易度 = nAction - 3100
	FLAG:畑拡張 = FLAG:農民難易度
CASE 4130 TO 4132
	FLAG:甲斐性無 = nAction == 4130 ? 0 # MAX(FLAG:甲斐性無, 1)
	FLAG:LUSTMODE = nAction == 4132
	SETBIT FLAG:1000, 3
	SETBIT FLAG:1000, 4
CASE 4141 TO 4143
	SIF !FLAG:甲斐性無
		RETURN 0
	FLAG:甲斐性無 = nAction - 4140
CASE 4110
	FLAG:STABLEBYPASS = !FLAG:STABLEBYPASS
CASE 4120
	SIF MAIN_MAP != 3 || !IS_MASTER(0)
		RETURN 0
	CALL SET_QUEST_FLAG(LSScarletAlias, QLSScarletActive, !QUEST_FLAG(LSScarletAlias, QLSScarletActive))
CASE 4200, 4201
	FLAG:YANDERE_EVOLVE_CHANCE = LIMIT(FLAG:YANDERE_EVOLVE_CHANCE + (nAction % 2 ? 1 # -1), 0, 100)
CASE 4202, 4203
	FLAG:YANDERE_SKIP_CHANCE = LIMIT(FLAG:YANDERE_SKIP_CHANCE + (nAction % 2 ? 1 # -1), 0, 100)
CASE 4204, 4205
	FLAG:YANDERE_TIER_2_CHANCE_BONUS = LIMIT(FLAG:YANDERE_TIER_2_CHANCE_BONUS + (nAction % 2 ? 1 # -1), 0, 100)
CASE 4210
	FLAG:YANDERE_RANDOM_EVOLUTION = !FLAG:YANDERE_RANDOM_EVOLUTION
CASE 4211
	CALL YANDERE_DEFAULTS_INIT(1)
CASE 4300 TO 4317
	nIndex = (nAction - 4300) / 2
	YANDERE_CHANCE:nIndex = LIMIT(YANDERE_CHANCE:nIndex + (nAction % 2 ? 1 # -1), 0, 100)
CASE 4401, 4402, 4403, 4405, 4410, 4450
	FLAG:YANDERE_EVENT_FREQUENCY = nAction - 4400
CASE 10001 TO 19999
	nIndex = nAction - 10000
	SIF nIndex >= CHARANUM || !IS_NAMED(nIndex) || nIndex == FLAG:なりきり
		RETURN 0
	ニューゲーム特典 '= TOSTR(nIndex)
CASE 20004 TO 23999
	nIndex = (nAction - 20000) / 4
	nChoice = (nAction - 20000) % 4
	SIF nIndex <= 0 || nIndex >= CHARANUM
		RETURN 0
	SIF CFLAG:nIndex:口上実装状況 <= 1 || nIndex == FLAG:なりきり || NO:nIndex != nIndex
		RETURN 0
	CALL HOTPATCH_SETUP_DIALOGUE_INFO(nIndex, nChoice)
	SIF !RESULT
		RETURN 0
	nSkip = ISSKIP()
	SKIPDISP 1
	gDialogueUpdateInit = 1
	CALL KOJO_RESET_AND_APPLY(nIndex, nChoice)
	gDialogueUpdateInit = 0
	SKIPDISP nSkip
CASEELSE
	RETURN 0
ENDSELECT
RETURN 1
