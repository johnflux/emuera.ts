; Inline startup controls use native settings and defer their effects to Start Game.
@HOTPATCH_SETUP_CHOICE(nValue, sName, nSelected, sDescription = "", nEnabled = 1, sRegion = "", nHomeRegion = 0, sEmphasis = "")
#FUNCTIONS
#DIM DYNAMIC nValue
#DIMS DYNAMIC sName
#DIM DYNAMIC nSelected
#DIMS DYNAMIC sDescription
#DIM DYNAMIC nEnabled
#DIMS DYNAMIC sRegion
#DIM DYNAMIC nHomeRegion
#DIMS DYNAMIC sEmphasis
#DIMS DYNAMIC sRegionLabel
sDescription '= REPLACE(HTML_ESCAPE(sDescription), "&lt;br&gt;", "&#10;")
SIF sEmphasis != ""
	sDescription '= REPLACE(sDescription, HTML_ESCAPE(sEmphasis), "<strong>" + HTML_ESCAPE(sEmphasis) + "</strong>")
IF sRegion != ""
	sRegionLabel '= " · " + HTML_ESCAPE(sRegion)
	SIF nHomeRegion
		sRegionLabel '= " · <strong>" + HTML_ESCAPE(sRegion) + "</strong> (Home region)"
ENDIF
RETURNF @"<button value='{nValue}' class='era-setup-choice%(nSelected ? " era-current" # "")%' aria-pressed='%(nSelected ? "true" # "false")%' aria-disabled='%(nEnabled ? "false" # "true")%'><span class='era-setup-choice-name'>%HTML_ESCAPE(sName)%</span><span class='era-setup-choice-description'>%sDescription%%sRegionLabel%</span></button>"

