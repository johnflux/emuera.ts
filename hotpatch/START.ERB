@SYSTEM_TITLE
#DIM DYNAMIC nStart
#DIMS DYNAMIC sError
LOADGLOBAL
SAVEGLOBAL
CLEARMEMORY
RESETBGCOLOR
WINDOW_TITLE = %GAMEBASE_TITLE% %ATWVersionName()%
CALL MAKE_TALENT_MAP
nStart = LINECOUNT
DO
	CLEARLINE LINECOUNT - nStart
	HTML_PRINT "<era-open class='era-launch'>"
	HTML_PRINT @"<div class='era-launch-version'>%HTML_ESCAPE(ATWVersionName())%</div>"
	HTML_PRINT "<era-open class='era-launch-art'>"
	FOR LOCAL, 0, 35
		HTML_PRINT "<p align='center'><img src='TW_title" + TOSTR(LOCAL, "000") + "'></p>"
	NEXT
	HTML_PRINT "<era-close>"
	HTML_PRINT "<div class='era-launch-actions'><button value='0' class='era-launch-primary'>New game</button><button value='1' class='era-launch-load'>Load game</button></div>"
	[IF_DEBUG]
	HTML_PRINT "<div class='era-launch-debug'><button value='99'>Dev Quicktest</button><button value='3'>Quicktest settings</button></div>"
	[ENDIF]
	HTML_PRINT @"<div class='era-launch-footer'>%HTML_ESCAPE(GAMEBASE_YEAR)% · AnonTW build forked from PedyTW, GUI-ified<span class='era-tone-red'>%sError%</span></div>"
	HTML_PRINT "<era-close>"
	INPUT
	sError '= ""
	SELECTCASE RESULT
	CASE 0
		RESETDATA
		CALL Name_Array_Set
		CALL ADDCHARA_INIT(0)
		CALL HOTPATCH_NEWGAME_PREPARE
		SIF RESULT
			BEGIN FIRST
	CASE 1
		CALL LOAD_SAVE(0, 1)
	[IF_DEBUG]
	CASE 99
		RESETDATA
		DevTest = 1
		CALL Name_Array_Set
		CALL ADDCHARA_INIT(0)
		BEGIN FIRST
	CASE 3
		CALL ADD_ALL_CHARACTERS
		CALL Name_Array_Set
		CALL MAKE_ALL_CLASS_LIST
		CALL OPTION_MOD_QUICKTEST
	[ENDIF]
	CASEELSE
		sError '= "Choose New game or Load game."
	ENDSELECT
LOOP 1

; Prepare on the title side so Cancel returns before EVENTFIRST performs updates or autosaves.
@HOTPATCH_NEWGAME_PREPARE
ゲーム開始処理中 = 1
SAVESTR:本体バージョン = %eraTW_Version%
SAVESTR:ATW_SAVE_VER = %ATW_VERSION%
CALL MAKE_ALL_CLASS_LIST
CALL DEFAULT_OPTION
CALL SET_CHARISMA("NEW")
PBAND = 12
DAY = 1
DAY:2 = 1
DAY:3 = 1
VAR_FERMENT = ただの水
IS_COLD_CROP_DAMAGE = 0
IS_STORM_CROP_DAMAGE = 0
IS_FLOOD_CROP_DAMAGE = 0
CONTINUOUS_RAINFALL = 0
CONTINUOUS_SNOWFALL = 0
SNOW_COVERAGE = 0
POSSIBLITY_AVALANCHE = 0
WEATHER_TIMEZOME = 0
YEAR_WEATHER_CONTROL = 0
CALL WEATHER_FORECAST_1TERM
CALL WEATHER_FORECAST_1DAY
CALL ADD_ALL_CHARACTERS
CALL ModImg_Set
CALL NEWGAME_MAKE
CALL SET_ALTERNATIVE_DEFAULTS
FLAG:CHILD_SUPPORT_RELIEF = 1
FLAG:MOB_PREGNANCY_TYPES = 1
FLAG:TWINS_CHANCE = 10
FLAG:TRIPLETS_CHANCE = 2
FOR LOCAL, 1, CHARANUM
	CALL KOJO_COUNT_CHECK(LOCAL)
NEXT
CALL DEFAULT_MAP_COLOR
CALL MakeAchievementListTemp
CALL HARDCORE_CONTENT_DEFAULT
CALL SET_MAINHOME
CALL NEWGAME_OPTION
RETURN RESULT

; EVENTFIRST retains its original update/event ordering after the setup is accepted.
@NEWGAME
IF !ゲーム開始処理中
	CALL HOTPATCH_ORIGINAL_NEWGAME
	RETURN RESULT
ENDIF
FOR LOCAL, 0, CHARANUM
	CFLAG:LOCAL:現在位置 = CFLAG:LOCAL:初期位置
	CALL SELECT_CLOTHES(LOCAL, "今日の衣装")
	CALL CTRL_CLOTHES_SET(LOCAL, "現在衣装の変更_普段着")
	CALL CLOTHES_SETTING_TRAIN(LOCAL)
	CALL 下着確認リセット(LOCAL)
	CVARSET BASE, GETNUM(BASE, "酒気"), 0
NEXT
TIME:3 = 420
CALL SET_SLEEP(1, MASTER, 0)
ゲーム開始処理中 = 0
CALL INIT_STARTINGLV
FLAG:BASE_RESET_DONE = 1
CALL ADD_EXTENDED_TRAITS_SET_ALL()
CALL INIT_QUESTS()
CALL LS_SETUP(1)
BREWING_KNOWN_DRINKS_CHECKED = 1
BREWING_KNOWN_DRINKS:1 = 1
RETURN 0

; Keep the native initialization and optional editors, but do not require a questionnaire.
@NEWGAME_MAKE
IF DevTest
	CALL HOTPATCH_ORIGINAL_NEWGAME_MAKE
	RETURN
ENDIF
CALL NEWGAME_MAKE_INIT
FLAG:ゲームモード = 0
CALL CHARA_VALIDATE(MASTER)

@SET_MAINHOME
#DIM DYNAMIC nSkip
IF ゲーム開始処理中 && !引っ越し
	MAIN_MAP = 0
	CALL ROOMSETTING_0
	CALL DEFAULT_OWNER_0
	nSkip = ISSKIP()
	SKIPDISP 1
	CALL MAP_DEFAULTRESIDENT(MAIN_MAP)
	SKIPDISP nSkip
	RETURN
ENDIF
CALL HOTPATCH_ORIGINAL_SET_MAINHOME

@引っ越し初期位置設定
IF ゲーム開始処理中 && !引っ越し
	CALL デフォルト引っ越し
	RETURN
ENDIF
CALL HOTPATCH_ORIGINAL_引っ越し初期位置設定

@NEWGAME_DIALOGUE_SELECT(ARG)
SIF ゲーム開始処理中
	RETURN
CALL HOTPATCH_DIALOGUE

@DEFAULT_MAP_COLOR
RECOLOREDMAPS = 1
ANIMATERECOLOREDMAPS = 1000

@NEWGAME_OPTION
#DIM DYNAMIC nStart
#DIM DYNAMIC nTab
#DIM DYNAMIC nPlayerPage = 4
#DIM DYNAMIC nDefaultClothes = 1
#DIM DYNAMIC nAction
#DIM DYNAMIC nLastBodyAction
#DIMS DYNAMIC sError
IF !ゲーム開始処理中
	CALL HOTPATCH_ORIGINAL_NEWGAME_OPTION
	RETURN
ENDIF
SETBIT FLAG:1000, 1
SETBIT FLAG:1000, 2
CALL CHARA_VALIDATE(MASTER)
SIF !TALENT:MASTER:形状 && HAS_PENIS(MASTER)
	TALENT:MASTER:形状 = 3
CALL MASTER_CLOTHES_INIT
nStart = LINECOUNT
DO
	SIF nDefaultClothes
		CALL MASTER_CLOTHES_INIT
	CLEARLINE LINECOUNT - nStart
	HTML_PRINT "<era-open class='era-dialog era-setup'>"
	HTML_PRINT "<div class='era-inventory-header'><div class='era-inventory-heading'><span class='era-inventory-title'>New game</span><button value='999' class='era-dialog-close' title='Back to title'>×</button></div></div>"
	HTML_PRINT @"<div class='era-sheet-subpages era-start-tabs'><button value='700' class='era-sheet-subpage%(nTab == 0 ? " era-current" # "")%'>Player</button><button value='706' class='era-sheet-subpage%(nTab == 6 ? " era-current" # "")%'>Characters</button><button value='701' class='era-sheet-subpage%(nTab == 1 ? " era-current" # "")%'>World</button><button value='703' class='era-sheet-subpage%(nTab == 3 ? " era-current" # "")%'>Bonuses</button><button value='704' class='era-sheet-subpage%(nTab == 4 ? " era-current" # "")%'>Farming</button><button value='702' class='era-sheet-subpage%(nTab == 2 ? " era-current" # "")%'>Dialogue</button><button value='705' class='era-sheet-subpage%(nTab == 5 ? " era-current" # "")%'>Yandere</button></div>"
	HTML_PRINT "<era-open class='era-inventory-body era-setup-body'>"
	SELECTCASE nTab
	CASE 0
		CALL HOTPATCH_SETUP_PLAYER(nPlayerPage, nDefaultClothes)
	CASE 1
		HTML_PRINT "<era-open class='era-setup-world'>"
		CALL HOTPATCH_SETUP_WORLD
		HTML_PRINT @"<div class='era-setup-card'><span class='era-launch-eyebrow'>Map Display</span><div class='era-setup-indent'><button value='23' class='era-chip-button'>Animation: %(ANIMATERECOLOREDMAPS ? "On" # "Off")%</button></div></div>"
		HTML_PRINT "<era-close>"
	CASE 2
		CALL HOTPATCH_SETUP_DIALOGUE
	CASE 3
		CALL HOTPATCH_SETUP_BONUSES
	CASE 4
		CALL HOTPATCH_SETUP_FARMING
	CASE 5
		CALL HOTPATCH_SETUP_YANDERE
	CASE 6
		CALL HOTPATCH_SETUP_CHARACTER_BODIES(nLastBodyAction)
	ENDSELECT
	HTML_PRINT "<era-close>"
	HTML_PRINT @"<div class='era-inventory-footer'><span class='era-tone-red'>%sError%</span><button value='100' class='era-launch-primary'>Start game</button></div>"
	HTML_PRINT "<era-close>"
	INPUT
	nAction = RESULT
	sError '= ""
	SIF nAction == 1199
		nDefaultClothes = 1
	SIF GROUPMATCH(nAction, 1101, 1102, 1103, 1104, 1105, 1106, 1108, 1109, 1110)
		nDefaultClothes = 0
	CALL HOTPATCH_SETUP_INPUT(nAction)
	SIF RESULT
		CONTINUE
	SELECTCASE nAction
	CASE 100
		CALL HOTPATCH_START_APPLY
		RETURN 1
	CASE 999
		ゲーム開始処理中 = 0
		RETURN 0
	CASE 700 TO 706
		nTab = nAction - 700
	CASE 710 TO 713
		nPlayerPage = nAction - 710
	CASE 715
		nPlayerPage = 4
	CASE 714
		CONTINUE
	CASE 12
		SIF !FLAG:なりきり
			CONTINUE
		CFLAG:(FLAG:なりきり):出禁 = 0
		FLAG:なりきり = 0
		ADDCHARA 0
		COPYCHARA CHARANUM - 1, MASTER
		DELCHARA CHARANUM - 1
		CALL ADDCHARA_INIT(MASTER, 1)
		CALL NEWGAME_MAKE
		CALL HOTPATCH_SETUP_HOME(MAIN_MAP)
		nDefaultClothes = 1
		CALL MASTER_CLOTHES_INIT
		TALENT:MASTER:形状 = 3
	CASE 5002
		INPUTS
		SIF RESULTS != ""
			NAME:MASTER '= RESULTS
		INPUTS
		IF RESULTS != ""
			CALLNAME:MASTER '= RESULTS
		ELSE
			CALLNAME:MASTER '= NAME:MASTER
		ENDIF
	CASE 23
		ANIMATERECOLOREDMAPS = ANIMATERECOLOREDMAPS ? 0 # 1000
	CASE 9500 TO 9911
		IF HOTPATCH_SETUP_NUMBER_LIMIT(nAction - 9500) >= 0
			PRINTFORML Enter a whole number ({HOTPATCH_SETUP_NUMBER_LIMIT(nAction - 9500)}-{HOTPATCH_SETUP_NUMBER_LIMIT(nAction - 9500, 1)})
			INPUT
			IF RESULT >= HOTPATCH_SETUP_NUMBER_LIMIT(nAction - 9500) && RESULT <= HOTPATCH_SETUP_NUMBER_LIMIT(nAction - 9500, 1)
				CALL HOTPATCH_SETUP_INPUT(160000 + (nAction - 9500) * 10000 + RESULT)
			ELSE
				sError '= "Number outside the allowed range."
			ENDIF
		ENDIF
	CASE 11
		CLEARLINE LINECOUNT - nStart
		CALL HOTPATCH_SETUP_PREDEFINED
		IF RESULT
			FLAG:ゲームモード = 1
			nDefaultClothes = 1
			CALL MASTER_CLOTHES_INIT
			CALL HOTPATCH_CHARACTER_HOME
		ENDIF
	CASE 26
		nTab = 6
	CASE 45001 TO 45021
		CLEARLINE LINECOUNT - nStart
		HTML_PRINT "<era-open class='era-dialog era-setup era-setup-editor'>"
		HTML_PRINT "<div class='era-inventory-header'><span class='era-inventory-title'>Character Bodies</span></div>"
		HTML_PRINT "<era-open class='era-inventory-body'>"
		CALL HOTPATCH_SETUP_CHARACTER_BODY_ACTION(nAction - 45000)
		nLastBodyAction = nAction - 45000
		HTML_PRINT "<era-close>"
		HTML_PRINT "<era-close>"
	CASE 10, 20, 31, 32, 5000, 5001, 9000 TO 9109
		CLEARLINE LINECOUNT - nStart
		HTML_PRINT "<era-open class='era-dialog era-setup era-setup-editor'>"
		HTML_PRINT "<div class='era-inventory-header'><span class='era-inventory-title'>Game settings</span><div class='era-sub'>Finish editing to return to new-game setup.</div></div>"
		HTML_PRINT "<era-open class='era-inventory-body'>"
		SELECTCASE nAction
		CASE 5000, 5001
			CALL CUSTOM_NAME(MASTER, nAction - 5000)
		CASE 9000 TO 9109
			CALL CUSTOM_EXP(nAction - 9000, MASTER)
			CALL CHARA_VALIDATE(MASTER)
		CASE 10
			CALL CUSTOM_TERMINAL(MASTER)
		CASE 20
			; The original home picker owns its initialization and all move-in side effects.
			CALL HOTPATCH_ORIGINAL_SET_MAINHOME
			SIF MAIN_MAP != 3
				CALL SET_QUEST_FLAG(LSScarletAlias, QLSScarletActive, 0)
		CASE 31
			CALL YANDERE_SET_MENU
		CASE 32
			CALL LS_RULES
			WAIT
		ENDSELECT
		HTML_PRINT "<era-close>"
		HTML_PRINT "<era-close>"
	CASEELSE
		sError '= "Choose an option or Start game."
	ENDSELECT
LOOP 1

@HOTPATCH_START_APPLY
CALL VIRGIN_SET_APPLY
CALL SET_BODY_APPLY
CALL NEWGAME_BONUS_APPLY
CALL SET_APPLY_NOUMIN
ITEM:安物食材 = 10

@HOTPATCH_DIALOGUE
HTML_PRINT "<era-open class='era-dialog era-setup era-setup-editor'>"
HTML_PRINT "<div class='era-inventory-header'><span class='era-inventory-title'>Character dialogue</span></div>"
HTML_PRINT "<era-open class='era-inventory-body'>"
CALL HOTPATCH_ORIGINAL_NEWGAME_DIALOGUE_SELECT
HTML_PRINT "<era-close>"
HTML_PRINT "<era-close>"

@HOTPATCH_CHARACTER_HOME
#DIM DYNAMIC nSkip
SIF !CFLAG:MASTER:自宅位置
	RETURN
MAIN_MAP = CFLAG:MASTER:自宅位置 / 100
TRYCALLFORM ROOMSETTING_{MAIN_MAP}
拠点_大家 = MASTER
デフォルト初期位置 = CFLAG:MASTER:初期位置
nSkip = ISSKIP()
ゲーム開始処理中 = 0
SKIPDISP 1
CALL MAP_DEFAULTRESIDENT(MAIN_MAP)
SKIPDISP nSkip
ゲーム開始処理中 = 1
SIF MAIN_MAP != 3
	CALL SET_QUEST_FLAG(LSScarletAlias, QLSScarletActive, 0)

@LOAD_SAVE(ARG, ARG:1 = 0)
#DIM DYNAMIC nStart
#DIM DYNAMIC nSlot
#DIM DYNAMIC nCheck
#DIM DYNAMIC nPage
#DIM DYNAMIC nAction
#DIMS DYNAMIC sError
#DIMS DYNAMIC sLabel
IF ARG != 0 || ARG:1 != 1
	HTML_PRINT "<era-open class='era-dialog era-setup era-setup-editor'>"
	HTML_PRINT "<div class='era-inventory-header'><div class='era-inventory-heading'><span class='era-inventory-title'>Save games</span><button value='999' class='era-dialog-close' title='Close'>×</button></div></div>"
	HTML_PRINT "<era-open class='era-inventory-body'>"
	CALL HOTPATCH_ORIGINAL_LOAD_SAVE(ARG, ARG:1)
	HTML_PRINT "<era-close>"
	HTML_PRINT "<era-close>"
	RETURN
ENDIF
LOADGLOBAL
nPage = LIMIT(GLOBAL:999, 0, 9)
nStart = LINECOUNT
DO
	CLEARLINE LINECOUNT - nStart
	HTML_PRINT "<era-open class='era-dialog era-load'>"
	HTML_PRINT "<div class='era-inventory-header'><div class='era-inventory-heading'><span class='era-inventory-title'>Load game</span><button value='999' class='era-dialog-close' title='Close load game'>×</button></div></div>"
	HTML_PRINT "<era-open class='era-inventory-body era-save-list'>"
	FOR nSlot, nPage * 20, nPage * 20 + 20
		CHKDATA nSlot
		nCheck = RESULT
		sLabel '= RESULTS
		IF nCheck == 0
			HTML_PRINT @"<button value='{nSlot}' class='era-save-slot'><span class='era-save-number'>Slot {nSlot}</span><span>%HTML_ESCAPE(sLabel)%</span><span class='era-save-resume'>Continue</span></button>"
		ELSE
			HTML_PRINT @"<div class='era-save-slot era-save-empty'><span class='era-save-number'>Slot {nSlot}</span><span>%(nCheck == 1 ? "Empty slot" # HTML_ESCAPE(sLabel))%</span></div>"
		ENDIF
	NEXT
	CHKDATA 300
	IF RESULT == 0
		HTML_PRINT @"<button value='300' class='era-save-slot era-save-auto'><span class='era-save-number'>Autosave</span><span>%HTML_ESCAPE(RESULTS)%</span><span class='era-save-resume'>Continue</span></button>"
	ENDIF
	HTML_PRINT "<era-close>"
	HTML_PRINT @"<div class='era-inventory-footer'><button value='1000' class='era-chip-button'>Previous</button><span>Page {nPage + 1} / 10</span><button value='1002' class='era-chip-button'>Next</button><span class='era-tone-red'>%HTML_ESCAPE(sError)%</span><button value='999' class='era-chip-button'>Cancel</button></div>"
	HTML_PRINT "<era-close>"
	INPUT
	nAction = RESULT
	sError '= ""
	SELECTCASE nAction
	CASE 999
		RETURN
	CASE 1000
		nPage = (nPage + 9) % 10
	CASE 1002
		nPage = (nPage + 1) % 10
	CASE 0 TO 199, 300
		CHKDATA nAction
		IF RESULT == 0
			GLOBAL:998 = nAction
			GLOBAL:999 = nPage
			SAVEGLOBAL
			LOADDATA nAction
		ELSE
			sError '= RESULT == 1 ? "Empty slot" # RESULTS
		ENDIF
	CASEELSE
		sError '= "Choose an available save."
	ENDSELECT
LOOP 1
