; Keep command effects and character reactions, but let the GUI announce time transitions.
@COM355
CALL HOTPATCH_ORIGINAL_COM355
LOCAL = RESULT
RESETBGCOLOR
RETURN LOCAL

@TRAIN_MESSAGE
RESETCOLOR
IF TFLAG:TRAIN_MESSAGE_CALLED
	CALL SET_KOJO_COLOR
	RETURN
ENDIF
TFLAG:TRAIN_MESSAGE_CALLED = 1
SIF SELECTCOM != 355 && (SELECTCOM != 495 || TFLAG:50)
	DRAWLINE
RESULT = 1
FOR LOCAL, 0, CHARANUM
	IF TCVAR:LOCAL:22
		CALL DATUI_BOTTOM_LATE(PLAYER, TCVAR:LOCAL:22)
	ELSEIF TCVAR:LOCAL:23
		CALL DATUI_BOTTOM_LATE(LOCAL, TCVAR:LOCAL:23)
	ELSEIF TCVAR:LOCAL:24
		CALL DATUI_TOP_LATE(PLAYER, TCVAR:LOCAL:24)
	ELSEIF TCVAR:LOCAL:25
		CALL DATUI_TOP_T_LATE(LOCAL, TCVAR:LOCAL:25)
	ENDIF
NEXT
IF TEQUIP:乳首吸い && !GROUPMATCH(SELECTCOM,7,11,21,22,50,51,350,188)
	CALL MESSAGE_EQUIP_COM11
ELSEIF TEQUIP:胸揉み && !GROUPMATCH(SELECTCOM,12,21,22,50,51,350,188)
	CALL MESSAGE_EQUIP_COM12
ELSEIF TEQUIP:BALL_LICKING && !GROUPMATCH(SELECTCOM,12,21,22,51,50,350,188)
	CALL ADD_MESSAGE_EQUIP_CUSTOM_COM17
ENDIF
IF TFLAG:50
	TRYCCALLFORM MESSAGE_SCOM{TFLAG:50}
		PRINTW
	CATCH
	ENDCATCH
ELSEIF SELECTCOM != 355
	TRYCCALLFORM MESSAGE_COM{SELECTCOM}
		SIF SELECTCOM != 495
			PRINTW
	CATCH
	ENDCATCH
ENDIF
IF CFLAG:MASTER:うふふ != 2 && SELECTCOM != 461
	CALL カウンター呼び出し処理
ENDIF
CALL SET_KOJO_COLOR()

; The resume routine already gates just its announcement and PRINTFORMW on this query.
@LS_RESTRICTION(RestrictionQuery, RestrictionInt:0, RestrictionInt:1)
#FUNCTION
#DIMS DYNAMIC RestrictionQuery
#DIM DYNAMIC RestrictionInt, 2
SIF RestrictionQuery == "Resume time print"
	RETURNF 1
RETURNF HOTPATCH_ORIGINAL_LS_RESTRICTION(RestrictionQuery, RestrictionInt:0, RestrictionInt:1)
