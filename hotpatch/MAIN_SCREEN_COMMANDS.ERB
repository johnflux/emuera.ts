	CASE 1
		nOld = CFLAG:TARGET:Ａアンフィルタ
		CFLAG:TARGET:Ａアンフィルタ = nValue
	CASE 2
		nOld = CFLAG:TARGET:RevSexFilter
		CFLAG:TARGET:RevSexFilter = nValue
	CASE 3
		nOld = CFLAG:TARGET:ＳＭアンフィルタ
		CFLAG:TARGET:ＳＭアンフィルタ = nValue
	CASE 4
		nOld = CFLAG:TARGET:奉仕アンフィルタ
		CFLAG:TARGET:奉仕アンフィルタ = nValue
	CASE 5
		nOld = CFLAG:TARGET:RevServiceFilter
		CFLAG:TARGET:RevServiceFilter = nValue
	CASE 6
		nOld = CFLAG:TARGET:セクハラアンフィルタ
		CFLAG:TARGET:セクハラアンフィルタ = nValue
	CASE 7
		nOld = FLAG:家事アンフィルタ
