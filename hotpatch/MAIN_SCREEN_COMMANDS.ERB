			;custom code
			HTML_PRINT HOTPATCH_BUTTON(@"%FLAG:デート相手 ? "Finish Date" # "Return Home"%({QOL_RETURN_HOME_TIME_REQUIRED()}min)", 999)
			RESETCOLOR
		ENDIF
	ENDIF
	HTML_PRINT "<era-close>"
ENDIF
