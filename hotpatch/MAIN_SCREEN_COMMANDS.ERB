		nEnabled = RESULT != 0 && TFLAG:100
		SIF STRCOUNT(SAVESTR:0, @"{ADD_CUSTOM_COM}")
			nEnabled = 0
	ENDIF
	IF nCommand == 51
		nEnabled = 0
		sReason '= "Already taken."
	ENDIF
	VARSET COM_DISPLAY_COLOR
	VARSET COM_DISPLAY_BEHAVIOR
	SIF !GROUPMATCH(nCommand, 826, 9017)
		CALL COM_DISPLAY_TR(nCommand)
	IF sReason != "" || COM_DISPLAY_BEHAVIOR == -1
		nEnabled = 0
	ENDIF
	HTML_PRINT "<era-open class='era-in-play-item'>"
	HTML_PRINT HOTPATCH_BUTTON(HOTPATCH_ACTION_RELEASE_LABEL(nCommand), nCommand, sReason, "block", "era-button-tone-" + HOTPATCH_ACTION_KIND(nCommand), "", "", nEnabled)
	SIF sReason != "" && nCommand != 51
		HTML_PRINT @"<span class='era-sub'>%HTML_ESCAPE(sReason)%</span>"
	HTML_PRINT "<era-close>"
NEXT
SIF nOpen
	HTML_PRINT "<era-close>"

