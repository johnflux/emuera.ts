				HTML_PRINT HOTPATCH_BUTTON("Measure Body", 824)
			ELSE
				HTML_PRINT HOTPATCH_BUTTON("Finish Body Measuring", 824)
			ENDIF
		ENDIF
		SIF TFLAG:パンツ収奪 && !GETBIT (FLAG:USERCOMフィルタ, 61) ;com custom code
			HTML_PRINT HOTPATCH_BUTTON("Take Panties", 825)
		IF TARGET && !CFLAG:Hypno_Orgasm_Denial ;custom code
			IF !TEQUIP:焦らしモード
				HTML_PRINT HOTPATCH_BUTTON("Denial Mode", 826)
			ENDIF
		ENDIF
		IF CFLAG:うふふ
			HTML_PRINT HOTPATCH_BUTTON("Stop Mischief", 999)
		ELSE
			HTML_PRINT HOTPATCH_BUTTON("Resume Time", 999)
		ENDIF
	ELSEIF FLAG:70 == 1 && CFLAG:TARGET:344 == 1
			HTML_PRINT HOTPATCH_BUTTON("Resume Time", 999)
		IF CFLAG:うふふ
			SIF EQUIP:0 && TARGET
				HTML_PRINT HOTPATCH_BUTTON("Strip Clothes", 820)
			;addition custom code
			SIF CFLAG:うふふ
				HTML_PRINT HOTPATCH_BUTTON("Undress", 892)

			IF CFLAG:うふふ == 2
				IF TFLAG:抱きつきモード
					HTML_PRINT HOTPATCH_BUTTON("Shake Off", 850)
				ELSE
					HTML_PRINT HOTPATCH_BUTTON("Slip Out", 850)
				ENDIF
				IF !CFLAG:Hypno_Orgasm_Denial ;custom code
					IF !TEQUIP:焦らしモード
						HTML_PRINT HOTPATCH_BUTTON("Denial Mode", 826)
					ENDIF
				ENDIF
			ELSE
				HTML_PRINT HOTPATCH_BUTTON("End Session", 999)
			ENDIF
		ENDIF
	ELSEIF (CFLAG:うふふ && !CFLAG:イタズラ) || FREE_USE_ACTIVE() ;custom code, enable stripping clothes when in Free Use mode
		SIF EQUIP:0 && TARGET && (!(TFLAG:102 == 3 && TFLAG:抱きつきモード) || FREE_USE_ACTIVE()) ;custom code, enable stripping clothes when in Free Use mode
			HTML_PRINT HOTPATCH_BUTTON("Strip Clothes", 820)
			;addition custom code
			SIF CFLAG:うふふ
				HTML_PRINT HOTPATCH_BUTTON("Undress", 892)
			IF TARGET && !CFLAG:Hypno_Orgasm_Denial ;custom code
				IF !TEQUIP:焦らしモード
					HTML_PRINT HOTPATCH_BUTTON("Denial Mode", 826)
				ENDIF
			ENDIF
		IF FLAG:70 == 1 && CFLAG:TARGET:344 == 0
			HTML_PRINT HOTPATCH_BUTTON("Resume Time", 999)
		ELSEIF CFLAG:うふふ == 2
			IF TFLAG:抱きつきモード
				HTML_PRINT HOTPATCH_BUTTON("Shake Off", 850)
			ELSE
				HTML_PRINT HOTPATCH_BUTTON("Slip Out", 850)
			ENDIF
		ELSEIF CFLAG:うふふ == 1
			HTML_PRINT HOTPATCH_BUTTON("End Session", 999)
		ENDIF
	ENDIF

	IF CFLAG:イタズラ
		SIF CFLAG:イタズラ < 2 && (EXP:TARGET:睡眠姦経験 > 100 || TCVAR:睡眠薬強度 || TCVAR:睡眠深度 > 2000)
			HTML_PRINT HOTPATCH_BUTTON("Unbutton Clothes", 830)
		;addition custom code
		SIF CFLAG:うふふ
			HTML_PRINT HOTPATCH_BUTTON("Undress", 892)
		IF CFLAG:イタズラ < 2
			HTML_PRINT HOTPATCH_BUTTON("Stop Mischief", 999)
			IF EQUIP:0 && TARGET && EQUIP:TARGET:下半身下着２ != 0 && GET_INT(TARGET, "下半身下着_ずらし可能", EQUIP:TARGET:下半身下着２, "コレクション表示可能") ;addition custom code, only if collectable ;bug fix
				IF !PANTS_ALREADY_COLLECTED()
					FONTBOLD
					SETCOLOR COLOR("PINK")
					PRINT  
				ENDIF
				SIF !GETBIT (FLAG:USERCOMフィルタ, 60) ;com custom code
					HTML_PRINT HOTPATCH_BUTTON("Pilfer Panties", 821)
				RESETCOLOR
				FONTREGULAR
			ENDIF
		ENDIF
		SIF CFLAG:イタズラ > 1
		HTML_PRINT HOTPATCH_BUTTON("Stop Sleep Rape", 999)
	ENDIF
	IF CFLAG:添い寝中
		HTML_PRINT HOTPATCH_BUTTON("Stop Sleeping Together", 999)
	ENDIF
	IF CHK_DATENOW(CFLAG:MASTER:デート中) && (!FLAG:70 || CFLAG:TARGET:344 == 1) && !CFLAG:MASTER:うふふ && CFLAG:MASTER:現在位置 != OMANEKIBEYA() && TFLAG:妄想中 != 1
		IF !FLAG:デート相手 && GETBIT(FLAG:瞬間移動, AT_HOME(MASTER)) && QOL_RETURN_HOME_TIME_REQUIRED() * 3 < BASE:MASTER:TSP
				SETCOLOR 0x5090FF
			HTML_PRINT HOTPATCH_BUTTON(@"Return Home({QOL_RETURN_HOME_TIME_REQUIRED() * 3}TSP)", 999)
			RESETCOLOR
		ELSE
			SIF QOL_RETURN_HOME_TIME_REQUIRED() < 10
				SETCOLOR 100, 250, 140
			;custom code
			HTML_PRINT HOTPATCH_BUTTON(@"%FLAG:デート相手 ? "Finish Date" # "Return Home"%({QOL_RETURN_HOME_TIME_REQUIRED()}min)", 999)
			RESETCOLOR
		ENDIF
	ENDIF
	HTML_PRINT "<era-close>"
ENDIF
HTML_PRINT "<era-close>"
CALL HOTPATCH_IN_PLAY(nAble, nAbleCount)
HTML_PRINT "<era-close>"
