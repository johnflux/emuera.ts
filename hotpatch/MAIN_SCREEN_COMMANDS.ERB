				HTML_PRINT HOTPATCH_BUTTON("Strip To Underwear", 823)
		ENDIF
		;addition custom code
		SIF CFLAG:うふふ || CFLAG:MASTER:イタズラ == 2
			HTML_PRINT HOTPATCH_BUTTON("Undress", 892)
		IF (MEASUREMENTCHECK(CFLAG:TARGET:現在位置) || MEASURE_DEBUG) ;custom code
			IF CFLAG:TARGET:身体測定 != 2
				HTML_PRINT HOTPATCH_BUTTON("Measure Body", 824)
			ELSE
				HTML_PRINT HOTPATCH_BUTTON("Finish Body Measuring", 824)
			ENDIF
		ENDIF
		SIF TFLAG:パンツ収奪 && !GETBIT (FLAG:USERCOMフィルタ, 61) ;com custom code
			HTML_PRINT HOTPATCH_BUTTON("Take Panties", 825)
		IF TARGET && !CFLAG:Hypno_Orgasm_Denial ;custom code
