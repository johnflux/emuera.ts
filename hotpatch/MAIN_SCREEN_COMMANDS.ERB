	IF COM_DISPLAY_BEHAVIOR == -1
		HTML_PRINT HOTPATCH_BUTTON(COM_NAME, nCom, "", "unavailable")
	ELSE
		HTML_PRINT HOTPATCH_BUTTON(COM_NAME, nCom)
	ENDIF
	RESETCOLOR
ELSEIF nCom >= 270 && nCom < 300
	;kojo com
	CALL KOJO_MESSAGE_SEND("COM", 0, TARGET, nCom - 270)
	HTML_PRINT HOTPATCH_BUTTON(RESULTS, nCom)
	nKojo = 1
ELSEIF nCom == 606 ;addition custom code
	LOCALS '= ""
	LOCAL:1 = 0
	FOR LOCAL:2,0,1000
		RESULT = 0
		TRYCALLFORM TSC_ABLE{LOCAL:2}()
		IF LOCAL:1 > 1
			LOCALS '= TRAINNAME_TR(606)
			BREAK
		ELSEIF RESULT == 2
			CALLFORM TSC_NAME{LOCAL:2}
			LOCALS '= RESULTS
			LOCAL:1 ++
		ENDIF
	NEXT
	SIF LOCALS != ""
		HTML_PRINT HOTPATCH_BUTTON(LOCALS, nCom)
ELSEIF nCom == 414 && CFLAG:MASTER:うふふ ;qol custom code
	HTML_PRINT HOTPATCH_BUTTON("Meal Break", nCom)
;Custom code
ELSEIF STRLENS(TRAINNAME_TR(nCom))
	;custom code
	SIF nCom == 401 ;highlight collection
		SETCOLOR 100, 250, 140
	HTML_PRINT HOTPATCH_BUTTON(TRAINNAME_TR(nCom), nCom)
	RESETCOLOR
ENDIF
RETURN nKojo

; Match QUICKFILTER's categories so filter chips and their actions share a tint.
; For overlapping tags, location takes priority, then SM, service and everyday categories.
@HOTPATCH_ACTION_KIND(nCommand)
#FUNCTIONS
