		;addition custom code
		SIF CFLAG:うふふ
			HTML_PRINT HOTPATCH_BUTTON("Undress", 892)
		IF CFLAG:イタズラ < 2
			HTML_PRINT HOTPATCH_BUTTON("Stop Mischief", 999)
			IF EQUIP:0 && TARGET && EQUIP:TARGET:下半身下着２ != 0 && GET_INT(TARGET, "下半身下着_ずらし可能", EQUIP:TARGET:下半身下着２, "コレクション表示可能") ;addition custom code, only if collectable ;bug fix
				IF !PANTS_ALREADY_COLLECTED()
					FONTBOLD
					SETCOLOR COLOR("PINK")
					PRINT  
				ENDIF
				SIF !GETBIT (FLAG:USERCOMフィルタ, 60) ;com custom code
					HTML_PRINT HOTPATCH_BUTTON("Pilfer Panties", 821)
