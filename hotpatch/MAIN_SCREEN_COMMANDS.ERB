@HOTPATCH_BUTTON(sLabel, nValue, sTitle = "", sVariant = "action", sClass = "", sState = "", sHelp = "", nEnabled = 1)
#FUNCTIONS
#DIMS DYNAMIC sLabel
#DIM DYNAMIC nValue
#DIMS DYNAMIC sClass
#DIMS DYNAMIC sTitle
#DIMS DYNAMIC sVariant
#DIMS DYNAMIC sSuffix
#DIMS DYNAMIC sState
#DIMS DYNAMIC sHelp
#DIM DYNAMIC nEnabled
#DIMS DYNAMIC sStateClass
SIF !GROUPMATCH(sVariant, "action", "sidebar", "sidebar-wide", "slim", "primary", "inventory", "unavailable", "list")
	THROW Unknown button variant: %sVariant%
IF GROUPMATCH(sVariant, "action", "sidebar", "sidebar-wide")
	sSuffix '= @"<span class='command-number'>[{nValue}]</span>"
ELSEIF sVariant == "inventory"
	sSuffix '= @" <span class='command-number'>[{nValue}]</span><span class='era-control-arrow'>›</span>"
ELSEIF sVariant == "unavailable"
	sSuffix '= "<span class='era-button-unavailable-mark'>[...]</span>"
ENDIF
sLabel '= HTML_ESCAPE(sLabel)
SIF GETCOLOR() != GETDEFCOLOR()
	sLabel '= @"<span color='#%TOSTR(GETCOLOR(), "X6")%'>%sLabel%</span>"
IF sVariant == "list"
	SIF GROUPMATCH(REPLACE(sState, "^\s+|\s+$", ""), "No", "no", "NO", "Off", "off", "OFF")
		sStateClass '= " era-config-state-off"
	sLabel '= @"<span class='era-config-setting'><span class='era-config-label'><span class='command-number'>[{nValue}]</span> %sLabel%</span><span class='era-config-state%sStateClass%'>%HTML_ESCAPE(sState)%</span></span><span class='era-config-help'>%HTML_ESCAPE(sHelp)%</span>"
ENDIF
RETURNF @"<button value='{nValue}' class='era-button era-button-%sVariant% %HOTPATCH_ATTRIBUTE(HTML_ESCAPE(sClass))%' aria-disabled='%(sVariant == "unavailable" || !nEnabled ? "true" # "false")%' title='%HOTPATCH_ATTRIBUTE(HTML_ESCAPE(sTitle))%'>%sLabel%%sSuffix%</button>"
