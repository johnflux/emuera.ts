;-------------------------------------------------------------------------------
; Action groups by command number (Train.csv's ranges).
;-------------------------------------------------------------------------------
@HOTPATCH_ACTION_GROUP(nCommand)
#FUNCTION
#DIM DYNAMIC nCommand
SIF nCommand < 200
	RETURNF 0
SIF nCommand < 270
	RETURNF 1
SIF nCommand < 300
	RETURNF 2
SIF nCommand < 350
	RETURNF 3
SIF nCommand < 400
	RETURNF 4
SIF nCommand < 600
	RETURNF 5
RETURNF 6

;-------------------------------------------------------------------------------
; A command's button, named as SHOW_USERCOM names it (alternative names, colours, kojo and 606 sub-commands).
; Returns 1 for a kojo command.
;-------------------------------------------------------------------------------
@HOTPATCH_PRINT_COM(nCom)
#FUNCTION
#DIM DYNAMIC nCom
#DIM DYNAMIC nKojo
#DIMS DYNAMIC COM_NAME
VARSET COM_DISPLAY_COLOR
VARSET COM_DISPLAY_BEHAVIOR
CALL COM_DISPLAY_TR(nCom) ;Custom code, control alternative command names.
COM_NAME '= RESULTS
IF !GROUPMATCH(COM_NAME, "Null", "")
	SIF COM_DISPLAY_COLOR
		SETCOLOR COM_DISPLAY_COLOR
	IF COM_DISPLAY_BEHAVIOR == -1
		PRINTFORMC %COM_NAME%[...]
	ELSE
		PRINTFORMC %COM_NAME%[{nCom,3}]
	ENDIF
	RESETCOLOR
ELSEIF nCom >= 270 && nCom < 300
	;kojo com
	CALL KOJO_MESSAGE_SEND("COM", 0, TARGET, nCom - 270)
	PRINTFORMC %RESULTS%[{nCom,3}]
	nKojo = 1
ELSEIF nCom == 606 ;addition custom code
	LOCAL:1 = 0
	FOR LOCAL:2,0,1000
		RESULT = 0
		TRYCALLFORM TSC_ABLE{LOCAL:2}()
		IF LOCAL:1 > 1
			LOCALS = %TRAINNAME_TR(606)%[{606,3}]
			BREAK
		ELSEIF RESULT == 2
			CALLFORM TSC_NAME{LOCAL:2}
			LOCALS = %RESULTS%[{606,3}]
			LOCAL:1 ++
		ENDIF
	NEXT
	PRINTFORMC %LOCALS%
ELSEIF nCom == 414 && CFLAG:MASTER:うふふ ;qol custom code
	PRINTFORMC Meal Break[{nCom,3}]
;Custom code
ELSEIF STRLENS(TRAINNAME_TR(nCom))
	;custom code
	SIF nCom == 401 ;highlight collection
		SETCOLOR 100, 250, 140
	PRINTFORMC %TRAINNAME_TR(nCom)%[{nCom,3}]
	RESETCOLOR
ENDIF
RETURNF nKojo

; Which filter toggle shows a command (QUICKFILTER's rules), so both share a tint: petting, housekeeping
; ("chores") or the character's own dialogue topics; "" for the rest.
@HOTPATCH_ACTION_KIND(nCommand)
#FUNCTIONS
#DIM DYNAMIC nCommand
SIF IS_COM_SEKUHARA(nCommand) && TARGET
	RETURNF "petting"
SIF IS_COM_KAJI(nCommand)
	RETURNF "chores"
SIF IS_COM_KOJO(nCommand)
	RETURNF "dialogue"
RETURNF ""

@HOTPATCH_ACTION_GROUP_NAME(nGroup)
#FUNCTIONS
#DIM DYNAMIC nGroup
#DIMS CONST sName, 7 = "Intimate", "Special", "Their Topics", "Talk &amp; Touch", "Advances", "Activities", "Outing"
RETURNF sName:nGroup

;-------------------------------------------------------------------------------
; フィルタ表示 as chips: which command groups are shown (a dim chip is filtered out), and the stalking star. Only the
; toggles in nFilters (bits as HOTPATCH_FILTER_SET numbers them) are shown: those that would change the actions now.
;-------------------------------------------------------------------------------
@HOTPATCH_FILTERS(nFilters)
#DIM DYNAMIC nFilters
#DIMS DYNAMIC sHtml
#DIMS DYNAMIC sTitle
IF TARGET > 0 && TARGET != MASTER
	sTitle '= @"Interact with %HTML_ESCAPE(CALLNAME:TARGET)%"
ELSE
	sTitle '= "Actions"
ENDIF
IF TARGET <= 0
	sHtml '= ""
ELSEIF STALKED == TARGET
	sHtml '= @"<button value='{TARGET + 4000}' class='era-star era-on' title='Following %HTML_ESCAPE(CALLNAME:TARGET)%&#10;When they leave, the Follow %HTML_ESCAPE(CALLNAME:TARGET)% action takes you to wherever they are at home.&#10;Click to stop.'>★</button>"
ELSE
	sHtml '= @"<button value='{TARGET + 4000}' class='era-star' title='Follow %HTML_ESCAPE(CALLNAME:TARGET)%&#10;Mark them as the one you follow: when they leave, a Follow %HTML_ESCAPE(CALLNAME:TARGET)% action takes you to wherever they are at home.'>★</button>"
ENDIF
IF (TARGET != MASTER && FREE_USE_ACTIVE()) || CFLAG:うふふ || CFLAG:MASTER:イタズラ == 2
	SIF GETBIT(nFilters, 0)
		sHtml += HOTPATCH_TOGGLE("V", 831, CFLAG:TARGET:Ｖアンフィルタ)
	SIF GETBIT(nFilters, 1)
		sHtml += HOTPATCH_TOGGLE("A", 832, CFLAG:TARGET:Ａアンフィルタ)
	SIF GETBIT(nFilters, 2)
		sHtml += HOTPATCH_TOGGLE("Rev Sex", -9121, CFLAG:TARGET:RevSexFilter)
	SIF GETBIT(nFilters, 3)
		sHtml += HOTPATCH_TOGGLE("SM", 836, CFLAG:TARGET:ＳＭアンフィルタ)
	SIF GETBIT(nFilters, 4)
		sHtml += HOTPATCH_TOGGLE("Service", 835, CFLAG:TARGET:奉仕アンフィルタ)
	SIF GETBIT(nFilters, 5)
		sHtml += HOTPATCH_TOGGLE("Rev Service", -9120, CFLAG:TARGET:RevServiceFilter)
ENDIF
SIF GETBIT(nFilters, 6)
	sHtml += HOTPATCH_TOGGLE("Petting", 837, CFLAG:TARGET:セクハラアンフィルタ, "petting", "Show touching actions she may not welcome (pink)")
SIF GETBIT(nFilters, 7)
	sHtml += HOTPATCH_TOGGLE("Housekeeping", 840, FLAG:家事アンフィルタ, "chores", "Show the housekeeping actions (green)")
SIF GETBIT(nFilters, 8)
	sHtml += HOTPATCH_TOGGLE("Dialogue", 839, !CFLAG:TARGET:hideKojoCom, "dialogue", "Show their own dialogue topics (blue)")
HTML_PRINT @"<div class='era-card-title era-actions-header'><span>%sTitle%</span><span class='era-toggles'>%sHtml%</span></div>"

;-------------------------------------------------------------------------------
; Sets filter flag nBit (the HOTPATCH_FILTERS order: V, A, Rev Sex, SM, Service, Rev Service, Petting, Housekeeping,
; hidden Dialogue) to nValue and returns what it was, so SHOW_USERCOM can try each toggle flipped and put it back.
;-------------------------------------------------------------------------------
@HOTPATCH_FILTER_SET(nBit, nValue)
#FUNCTION
#DIM DYNAMIC nBit
#DIM DYNAMIC nValue
#DIM DYNAMIC nOld
SELECTCASE nBit
	CASE 0
		nOld = CFLAG:TARGET:Ｖアンフィルタ
		CFLAG:TARGET:Ｖアンフィルタ = nValue
	CASE 1
		nOld = CFLAG:TARGET:Ａアンフィルタ
		CFLAG:TARGET:Ａアンフィルタ = nValue
	CASE 2
		nOld = CFLAG:TARGET:RevSexFilter
		CFLAG:TARGET:RevSexFilter = nValue
	CASE 3
		nOld = CFLAG:TARGET:ＳＭアンフィルタ
		CFLAG:TARGET:ＳＭアンフィルタ = nValue
	CASE 4
		nOld = CFLAG:TARGET:奉仕アンフィルタ
		CFLAG:TARGET:奉仕アンフィルタ = nValue
	CASE 5
		nOld = CFLAG:TARGET:RevServiceFilter
		CFLAG:TARGET:RevServiceFilter = nValue
	CASE 6
		nOld = CFLAG:TARGET:セクハラアンフィルタ
		CFLAG:TARGET:セクハラアンフィルタ = nValue
	CASE 7
		nOld = FLAG:家事アンフィルタ
		FLAG:家事アンフィルタ = nValue
	CASE 8
		nOld = CFLAG:TARGET:hideKojoCom
		CFLAG:TARGET:hideKojoCom = nValue
ENDSELECT
RETURNF nOld

; A toggle chip: lit when on (so its tooltip just says what it does); a filter's kind tints it like the actions it shows (HOTPATCH_ACTION_KIND).
@HOTPATCH_TOGGLE(sLabel, nValue, nOn, sKind, sTitle)
#FUNCTIONS
#DIMS DYNAMIC sLabel
#DIM DYNAMIC nValue
#DIM DYNAMIC nOn
#DIMS DYNAMIC sKind
#DIMS DYNAMIC sTitle
#DIMS DYNAMIC sClass
SIF STRLENS(sKind)
	sClass '= " era-kind-" + sKind
SIF STRLENS(sTitle)
	sTitle '= @" title='%sLabel%: %sTitle%'"
RETURNF @"<button value='{nValue}' class='era-toggle%sClass%%(nOn ? " era-on" # "")%'%sTitle%>%sLabel%</button>"

;-------------------------------------------------------------------------------
; QOL_EXTRA_COMMAND_BUTTONS as toggle chips, each only when it can matter: the sex settings (condom, moaning,
; standing) once something sexual can happen: a session, mischief, free use or stopped time. The original shows them
; whenever the target is not you, alone included. Pushdown Guard is on your card (MAIN_SCREEN.ERB).
;-------------------------------------------------------------------------------
@HOTPATCH_SETTINGS
#DIMS DYNAMIC sHtml
#DIMS DYNAMIC sMoan
sHtml '= "<button value='809' class='era-chip-button'>Config</button>"
sHtml += "<button value='-9201' class='era-chip-button'>Auto Items</button>"
IF TARGET > 0 && TARGET != MASTER && (CFLAG:MASTER:うふふ || CFLAG:TARGET:うふふ || CFLAG:MASTER:イタズラ || CFLAG:TARGET:イタズラ || FLAG:70 || FREE_USE_ACTIVE())
	sHtml += HOTPATCH_TOGGLE("Automatic Condom", 838, FLAG:自動ゴム)
	SELECTCASE CFLAG:オート喘ぎ
		CASE 0
			sMoan '= "Auto-moan: No"
		CASE 1
			sMoan '= "Auto-moan: Yes"
		CASE 2
			sMoan '= "Auto-moan: Yes (Ahegao)"
		CASEELSE
			sMoan '= "Invalid Option"
	ENDSELECT
	sHtml += HOTPATCH_TOGGLE(sMoan, 4000, CFLAG:オート喘ぎ)
	sHtml += HOTPATCH_TOGGLE("Standing", -9122, CFLAG:STANDING_TOGGLE)
ENDIF
HTML_PRINT @"<div class='era-toggles era-settings'>%sHtml%</div>"
