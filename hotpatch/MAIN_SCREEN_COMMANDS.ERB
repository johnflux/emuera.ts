;-------------------------------------------------------------------------------
; Hotpatch for the main screen's commands (ERB/コマンド関連/USERCOM_コマンド表示処理.ERB @SHOW_USERCOM), the second
; half of MAIN_SCREEN.ERB's panel layout, which it closes. The command rules are copied unchanged; the display:
; - the actions card: the filter toggles as chips, the commands grouped by number range instead of line breaks
;   (those a filter controls tinted like its toggle), the custom (9000+) commands, and the time stop/mischief/sleeping commands, moved up from the menu;
; - the "Go & Manage" card with the menu commands and the settings buttons of QOL_EXTRA_COMMAND_BUTTONS as chips.
; Dropped: the [Commands] collapse toggle [3002] (always expanded) and the line-filling "=" padding.
;-------------------------------------------------------------------------------
@SHOW_USERCOM
#DIM DYNAMIC printKojoCom
#DIMS DYNAMIC COM_NAME
#DIM HIGHLIGHT_SCOM ;qol custom code
#DIM DYNAMIC nGroup
#DIM DYNAMIC nNewGroup
#DIMS DYNAMIC sKind
#DIM DYNAMIC nSelfCare, 2
#DIM DYNAMIC nSelfCareCount
#DIM DYNAMIC nAble, 800
#DIM DYNAMIC nAbleCount
#DIM DYNAMIC nIndex
#DIM DYNAMIC nBit
#DIM DYNAMIC nOld
#DIM DYNAMIC nShown, 800
#DIM DYNAMIC nFilters
TFLAG:100 = !TFLAG:101
VARSET LOCAL
;前ターンのMASTERが射精した相手をLOCAL:1へセット
IF TCVAR:MASTER:112 == 1
	;V
	LOCAL:1 = MASTER_POSE(SET_V,SET_P,1)
ELSEIF TCVAR:MASTER:112 == 2
	;A
	LOCAL:1 = MASTER_POSE(SET_A,SET_P,1)
ENDIF


HTML_PRINT "<era-open class='era-card era-main-actions'>"
nAbleCount = 0

;コマンド表示 (the usable commands first, so the filters can leave out toggles that would change nothing)
FOR LOCAL,0,800
	SIF QOL_BLOCKED_COM_HIDDEN_SEX(LOCAL) ;qol custom code
		CONTINUE
	;qol custom code
	IF TARGET
		CALL KOJO_CHECK(TARGET, "COM_BLOCKED",,LOCAL)
		SIF RESULT
			CONTINUE
	ENDIF

	SIF LOCAL == 355 && (!FLAG:70 || CFLAG:TARGET:344 == 1)
		CONTINUE
	SIF GLOBAL_COMABLE2(LOCAL)
		CONTINUE
	SIF GROUPMATCH(LOCAL,400,405,604)
		CONTINUE
	SIF TRAINNAME:LOCAL == "" && !IS_COM_KOJO(LOCAL)
		CONTINUE
	SIF LOCAL == ADD_CUSTOM_COM ;addition custom code, don't display general custom com command, handled elsewhere
		CONTINUE
	RESULT = 0
	;現状で対象コマンドが使用可能かどうか判定
	TRYCALLFORM COM_ABLE{LOCAL}
	IF RESULT
		nAble:nAbleCount = LOCAL
		nAbleCount ++
	ENDIF
NEXT
; A filter toggle is shown only if flipping it would show or hide one of them (QUICKFILTER with its flag flipped,
; so per-command COM*_FILTER rules count too).
nFilters = 0
FOR nIndex, 0, nAbleCount
	nShown:nIndex = QUICKFILTER(nAble:nIndex) != 0
NEXT
FOR nBit, 0, 9
	nOld = HOTPATCH_FILTER_SET(nBit, 0)
	CALL HOTPATCH_FILTER_SET(nBit, !nOld)
	FOR nIndex, 0, nAbleCount
		IF (QUICKFILTER(nAble:nIndex) != 0) != nShown:nIndex
			SETBIT nFilters, nBit
			BREAK
		ENDIF
	NEXT
	CALL HOTPATCH_FILTER_SET(nBit, nOld)
NEXT
CALL HOTPATCH_FILTERS(nFilters)
nGroup = -1
FOR nIndex, 0, nAbleCount
	LOCAL = nAble:nIndex
	SIF !QUICKFILTER(LOCAL)
		CONTINUE
	IF GROUPMATCH(LOCAL, 414, 431)
		nSelfCare:nSelfCareCount = LOCAL
		nSelfCareCount ++
		CONTINUE
	ENDIF
	nNewGroup = HOTPATCH_ACTION_GROUP(LOCAL)
	IF nNewGroup != nGroup
		SIF nGroup >= 0
			HTML_PRINT "<era-close>"
		HTML_PRINT "<era-open class='era-actions-group'>"
		HTML_PRINT @"<div class='era-actions-title'>%HOTPATCH_ACTION_GROUP_NAME(nNewGroup)%</div>"
		nGroup = nNewGroup
	ENDIF
	sKind '= HOTPATCH_ACTION_KIND(LOCAL)
	SIF STRLENS(sKind)
		HTML_PRINT @"<era-open class='era-kind era-kind-%sKind%'>"
	SIF HOTPATCH_PRINT_COM(LOCAL)
		printKojoCom = 1
	SIF STRLENS(sKind)
		HTML_PRINT "<era-close>"
NEXT
;addition custom code
SIF nGroup >= 0
	HTML_PRINT "<era-close>"
HTML_PRINT "<era-open class='era-actions-group era-actions-more'>"
HTML_PRINT "<div class='era-actions-title'>More</div>"
CALL Add_Custom_List_COMS
HTML_PRINT "<era-close>"
CALL ADD_TOUCH_SET_OLD_FIELDS(1)
RESULT = 0
IF TFLAG:100
	HTML_PRINT "<era-open class='era-actions-group era-actions-situation'>"
	HTML_PRINT @"<div class='era-actions-title'>%(FLAG:70 ? "While time is stopped" # "Right now")%</div>"
	IF FLAG:70 == 1 && CFLAG:TARGET:344 == 0
		SIF EQUIP:0 && TARGET && CFLAG:うふふ
			PRINTC Remove Clothes[820]
		IF EQUIP:0 && TARGET && EQUIP:TARGET:下半身下着２ != 0 && GET_INT(TARGET, "下半身下着_ずらし可能", EQUIP:TARGET:下半身下着２, "コレクション表示可能") ;addition custom code, only if collectable
			IF !PANTS_ALREADY_COLLECTED()
				FONTBOLD
				SETCOLOR COLOR("PINK")
				PRINT  
			ENDIF
				SIF !GETBIT (FLAG:USERCOMフィルタ, 60) ;com custom code
					PRINTC Pilfer Panties[821]
				RESETCOLOR
				FONTREGULAR
		ENDIF
		IF (TEQUIP:5 == 0 || EQUIP:TARGET:上半身下着１) && CFLAG:うふふ
			SIF EQUIP:0 && TARGET && EQUIP:TARGET:上半身下着１ != 0 && (EQUIP:TARGET:着物 != 0 || EQUIP:TARGET:上半身上着２ != 0 || EQUIP:TARGET:ボディースーツ == 3)
				PRINTC Remove Top & Bottom[822]
		ENDIF
		IF TEQUIP:5 == 0 && CFLAG:うふふ
			SIF EQUIP:0 && TARGET && (EQUIP:TARGET:上半身下着１ || EQUIP:TARGET:上半身下着２ || EQUIP:TARGET:下半身下着１ || EQUIP:TARGET:下半身下着２ || EQUIP:TARGET:レオタード || EQUIP:TARGET:ボディースーツ) && (EQUIP:TARGET:上半身上着１ || EQUIP:TARGET:上半身上着２ || EQUIP:TARGET:ワンピース || EQUIP:TARGET:着物 || EQUIP:TARGET:外衣)
				PRINTC Strip To Underwear[823]
		ENDIF
		;addition custom code
		SIF CFLAG:うふふ || CFLAG:MASTER:イタズラ == 2
			PRINTC Undress[892]
		IF (MEASUREMENTCHECK(CFLAG:TARGET:現在位置) || MEASURE_DEBUG) ;custom code
			IF CFLAG:TARGET:身体測定 != 2
				PRINTC Measure Body[824]
			ELSE
				PRINTC Finish Body Measuring[824]
			ENDIF
		ENDIF
		SIF TFLAG:パンツ収奪 && !GETBIT (FLAG:USERCOMフィルタ, 61) ;com custom code
			PRINTC Take Panties[825]
		IF TARGET && !CFLAG:Hypno_Orgasm_Denial ;custom code
			IF TEQUIP:焦らしモード
				PRINTC End Denial[826]
			ELSE
				PRINTC Denial Mode[826]
			ENDIF
		ENDIF
		IF CFLAG:うふふ
			PRINTC Stop Mischief[999]
		ELSE
			PRINTC Resume Time[999]
		ENDIF
	ELSEIF FLAG:70 == 1 && CFLAG:TARGET:344 == 1
			PRINTC Resume Time[999]
		IF CFLAG:うふふ
			SIF EQUIP:0 && TARGET
				PRINTC Strip Clothes[820]
			;addition custom code
			SIF CFLAG:うふふ
				PRINTC Undress[892]

			IF CFLAG:うふふ == 2
				IF TFLAG:抱きつきモード
					PRINTC Shake Off[850]
				ELSE
					PRINTC Slip Out[850]
				ENDIF
				IF !CFLAG:Hypno_Orgasm_Denial ;custom code
					IF TEQUIP:焦らしモード
						PRINTC End Denial[826]
					ELSE
						PRINTC Denial Mode[826]
					ENDIF
				ENDIF
			ELSE
				PRINTC End Session[999]
			ENDIF
		ENDIF
	ELSEIF (CFLAG:うふふ && !CFLAG:イタズラ) || FREE_USE_ACTIVE() ;custom code, enable stripping clothes when in Free Use mode
		SIF EQUIP:0 && TARGET && (!(TFLAG:102 == 3 && TFLAG:抱きつきモード) || FREE_USE_ACTIVE()) ;custom code, enable stripping clothes when in Free Use mode
			PRINTC Strip Clothes[820]
			;addition custom code
			SIF CFLAG:うふふ
				PRINTC Undress[892]
			IF TARGET && !CFLAG:Hypno_Orgasm_Denial ;custom code
				IF TEQUIP:焦らしモード
					PRINTC End Denial[826]
				ELSE
					PRINTC Denial Mode[826]
				ENDIF
			ENDIF
		IF FLAG:70 == 1 && CFLAG:TARGET:344 == 0
			PRINTC Resume Time[999]
		ELSEIF CFLAG:うふふ == 2
			IF TFLAG:抱きつきモード
				PRINTC Shake Off[850]
			ELSE
				PRINTC Slip Out[850]
			ENDIF
		ELSEIF CFLAG:うふふ == 1
			PRINTC End Session[999]
		ENDIF
	ENDIF

	IF CFLAG:イタズラ
		SIF CFLAG:イタズラ < 2 && (EXP:TARGET:睡眠姦経験 > 100 || TCVAR:睡眠薬強度 || TCVAR:睡眠深度 > 2000)
			PRINTC Unbutton Clothes[830]
		;addition custom code
		SIF CFLAG:うふふ
			PRINTC Undress[892]
		IF CFLAG:イタズラ < 2
			PRINTC Stop Mischief[999]
			IF EQUIP:0 && TARGET && EQUIP:TARGET:下半身下着２ != 0 && GET_INT(TARGET, "下半身下着_ずらし可能", EQUIP:TARGET:下半身下着２, "コレクション表示可能") ;addition custom code, only if collectable ;bug fix
				IF !PANTS_ALREADY_COLLECTED()
					FONTBOLD
					SETCOLOR COLOR("PINK")
					PRINT  
				ENDIF
				SIF !GETBIT (FLAG:USERCOMフィルタ, 60) ;com custom code
					PRINTC Pilfer Panties[821]
				RESETCOLOR
				FONTREGULAR
			ENDIF
		ENDIF
		SIF CFLAG:イタズラ > 1
		PRINTC Stop Sleep Rape[999]
	ENDIF
	IF CFLAG:添い寝中
		PRINTC Stop Sleeping Together[999]
	ENDIF
	IF CHK_DATENOW(CFLAG:MASTER:デート中) && (!FLAG:70 || CFLAG:TARGET:344 == 1) && !CFLAG:MASTER:うふふ && CFLAG:MASTER:現在位置 != OMANEKIBEYA() && TFLAG:妄想中 != 1
		IF !FLAG:デート相手 && GETBIT(FLAG:瞬間移動, AT_HOME(MASTER)) && QOL_RETURN_HOME_TIME_REQUIRED() * 3 < BASE:MASTER:TSP
				SETCOLOR 0x5090FF
			PRINTFORMC Return Home({QOL_RETURN_HOME_TIME_REQUIRED() * 3}TSP)[999]
			RESETCOLOR
		ELSE
			SIF QOL_RETURN_HOME_TIME_REQUIRED() < 10
				SETCOLOR 100, 250, 140
			;custom code
			PRINTFORMC \@ FLAG:デート相手 ? Finish Date # Return Home \@({QOL_RETURN_HOME_TIME_REQUIRED()}min)[999]
			RESETCOLOR
		ENDIF
	ENDIF
	HTML_PRINT "<era-close>"
ENDIF
HTML_PRINT "<era-close>"
;自動実行中なら下記表示をスキップ
SIF !TFLAG:100
	GOTO SKIP
HTML_PRINT "<era-open class='era-card era-main-menu'>"
HTML_PRINT "<div class='era-card-title'>Go &amp; Manage</div>"
IF nSelfCareCount
