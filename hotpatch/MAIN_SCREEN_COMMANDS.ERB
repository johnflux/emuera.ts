@HOTPATCH_IN_PLAY(nAble, nAbleCount)
#DIM REF nAble
#DIM DYNAMIC nAbleCount
#DIM DYNAMIC nIndex
#DIM DYNAMIC nAvailableIndex
#DIM DYNAMIC nCommand
#DIM DYNAMIC nEnabled
#DIM DYNAMIC nOpen
#DIM CONST nCommands, 20 = 11, 12, 19, 42, 43, 44, 45, 46, 47, 48, 50, 51, 104, 105, 107, 181, 182, 189, 826, 9017
#DIMS DYNAMIC sReason
FOR nIndex, 0, 20
	nCommand = nCommands:nIndex
	SIF !HOTPATCH_ACTION_ACTIVE(nCommand)
		CONTINUE
	IF !nOpen
		HTML_PRINT "<era-open class='era-card era-in-play'>"
		HTML_PRINT "<div class='era-card-title'>In play</div>"
		nOpen = 1
	ENDIF
	nEnabled = 0
	sReason '= HOTPATCH_ACTION_REMOVE_REASON(nCommand)
	FOR nAvailableIndex, 0, nAbleCount
		IF nAble:nAvailableIndex == nCommand
			nEnabled = 1
			BREAK
		ENDIF
	NEXT
	IF nCommand == 826
		nEnabled = TFLAG:100 && TARGET && !CFLAG:Hypno_Orgasm_Denial && (CFLAG:うふふ || CFLAG:MASTER:イタズラ || FLAG:70)
	ENDIF
	IF nCommand == 9017
