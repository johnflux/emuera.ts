;-------------------------------------------------------------------------------
; Action groups by command number (Train.csv's ranges).
;-------------------------------------------------------------------------------
@HOTPATCH_ACTION_GROUP(nCommand)
#FUNCTION
#DIM DYNAMIC nCommand
SIF nCommand < 200
	RETURNF 0
SIF nCommand < 270
	RETURNF 1
SIF nCommand < 300
	RETURNF 2
SIF nCommand < 350
	RETURNF 3
SIF nCommand < 400
	RETURNF 4
SIF nCommand < 600
	RETURNF 5
RETURNF 6

