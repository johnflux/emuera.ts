; TW's native calculation and hooks, without its inaccurate daily-limit/feeling-removal prompt.
@HOTPATCH_RELATIONSHIP_CASUAL
#DIM DYNAMIC 理性判定値
#DIM DYNAMIC 欲望判定値
#DIM DYNAMIC 酒酔い
CALL KOJO_MESSAGE_SEND("SEX_FRIEND", 0, TARGET, 0, 0, "導入")
PRINTFORMW In %CALLNAME:TARGET%'s heart...
欲望判定値 = MIN(ABL:TARGET:欲望, 10) * 50
CALL SF_DESIRE_MOD(@"%ABL_TR(GETNUM(ABL, "欲望"))% {ABL:TARGET:欲望}", 欲望判定値)
欲望判定値 += MIN(ABL:TARGET:従順, 10) * 20
CALL SF_DESIRE_MOD(@"%ABL_TR(GETNUM(ABL, "従順"))% {ABL:TARGET:従順}", 欲望判定値)
欲望判定値 += MIN(EXP:TARGET:絶頂経験, 5000) / 10
CALL SF_DESIRE_MOD(@"%EXP_TR(GETNUM(EXP, "絶頂経験"))% {EXP:TARGET:絶頂経験}", 欲望判定値)
欲望判定値 += GETPALAMLV(PALAM:TARGET:欲情,15) * (30 + TALENT:TARGET:快感応答 * 10)
CALL SF_DESIRE_MOD(@"%PALAM_TR("欲情")%", 欲望判定値)
欲望判定値 += MAX(MARK:TARGET:快楽刻印, MARK:TARGET:時姦刻印) * 200
CALL SF_DESIRE_MOD(@"%MARK_TR(GETNUM(MARK, "快楽刻印"))%/%MARK_TR(GETNUM(MARK, "時姦刻印"))%", 欲望判定値)
IF TCVAR:TARGET:発情 || TCVAR:TARGET:媚薬
	欲望判定値 += 300
	CALL SF_DESIRE_MOD(@"In Heat/Aphrodisiac", 欲望判定値)
ENDIF
理性判定値 = 1000 + BASE:TARGET:理性 / 2
CALL SF_REASON_MOD(@"Reason：{BASE:TARGET:理性}", 理性判定値)
酒酔い = BASE:酒気 * 100 / MAXBASE:酒気
IF 酒酔い
	SIF 酒酔い > 70
		酒酔い *= 2
	理性判定値 -= 酒酔い
	CALL SF_REASON_MOD(@"Drunkenness", 理性判定値)
ENDIF
IF !(CFLAG:TARGET:既成事実 & 合意_うふふ)
	理性判定値 += 300
	CALL SF_REASON_MOD(@"【Lack of Consent】", 理性判定値)
ENDIF
IF TALENT:TARGET:無知
	理性判定値 -= 500
	CALL SF_REASON_MOD(@"【%TALENT_TR(GETNUM(TALENT, "無知"))%】", 理性判定値)
ENDIF
IF TALENT:TARGET:プライド
	理性判定値 += TALENT:TARGET:プライド * 150
	CALL SF_REASON_MOD(@"【%TALENT_TR(GETNUM(TALENT, "プライド"))%】", 理性判定値)
ENDIF
IF TALENT:TARGET:貞操 > 0
	理性判定値 += 200
	CALL SF_REASON_MOD(@"【%GET_TALENTNAME_TR(GETNUM(TALENT, "貞操"), 1)%】", 理性判定値)
ENDIF
IF TALENT:TARGET:貞操 < 0
	理性判定値 -= 200
	CALL SF_REASON_MOD(@"【%GET_TALENTNAME_TR(GETNUM(TALENT, "貞操"), -1)%】", 理性判定値)
ENDIF
IF MARK:TARGET:反発刻印
	理性判定値 += MARK:TARGET:反発刻印 * 100
	CALL SF_REASON_MOD(@"【%MARK_TR(GETNUM(MARK, "反発刻印"))%】", 理性判定値)
ENDIF
IF TALENT:TARGET:機嫌 < 0
	理性判定値 += 300
	CALL SF_REASON_MOD(@"【%GET_TALENTNAME_TR(GETNUM(TALENT, "機嫌"), -1)%】", 理性判定値)
ENDIF
IF TALENT:TARGET:処女
	理性判定値 += 300
	CALL SF_REASON_MOD(@"【%TALENT_TR(GETNUM(TALENT, "処女"))%】", 理性判定値)
ENDIF
IF TALENT:TARGET:倒錯的
	理性判定値 -= 200
	CALL SF_REASON_MOD(@"【%TALENT_TR(GETNUM(TALENT, "倒錯的"))%】", 理性判定値)
