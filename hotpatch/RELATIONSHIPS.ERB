IF TALENT:MASTER:謎の魅力
	理性判定値 -= 150
	CALL SF_REASON_MOD(@"Your【%TALENT_TR(GETNUM(TALENT, "謎の魅力"))%】", 理性判定値)
ENDIF
IF TALENT:MASTER:容姿 > 0
	理性判定値 -= 200
	CALL SF_REASON_MOD(@"Your【%TALENT_TR(GETNUM(TALENT, "容姿"))%】", 理性判定値)
ENDIF
IF TALENT:MASTER:魅力
	理性判定値 -= 150
	CALL SF_REASON_MOD(@"Your【%TALENT_TR(GETNUM(TALENT, "魅力"))%】", 理性判定値)
ENDIF
IF TALENT:TARGET:一線越えない
	理性判定値 += 200
	CALL SF_REASON_MOD(@"【%TALENT_TR(GETNUM(TALENT, "一線越えない"))%】", 理性判定値)
ENDIF
IF OTOKOGIRAI(TARGET)
	理性判定値 += 300
	CALL SF_REASON_MOD(@"Sexual Orientation", 理性判定値)
