; CFLAG 7398: formal commitment (0 none, 1 engaged, 2 married, -1 former engagement, -2 divorced).
@HOTPATCH_RELATIONSHIP_STATE(nChara)
#FUNCTION
#DIM DYNAMIC nChara
SIF !TALENT:nChara:恋人 && CFLAG:nChara:7398 > 0
	RETURNF 0
RETURNF CFLAG:nChara:7398

@HOTPATCH_RELATIONSHIP_LABEL(nChara)
#FUNCTIONS
#DIM DYNAMIC nChara
SELECTCASE HOTPATCH_RELATIONSHIP_STATE(nChara)
CASE 2
	RETURNF "Married"
CASE 1
	RETURNF "Engaged"
ENDSELECT
SIF TALENT:nChara:恋人
	RETURNF "Lovers"
SIF TALENT:nChara:セフレ
	RETURNF "Friends with benefits"
SIF HOTPATCH_FRIENDSHIP_ACTIVE(nChara)
	RETURNF "Friends"
RETURNF "No formal relationship"

@HOTPATCH_RELATIONSHIP_ICON(nChara)
#FUNCTIONS
#DIM DYNAMIC nChara
#DIMS DYNAMIC sState
#DIMS DYNAMIC sLabel
sState '= "none"
sLabel '= HOTPATCH_RELATIONSHIP_LABEL(nChara)
IF HOTPATCH_RELATIONSHIP_STATE(nChara) == 2
	sState '= "married"
ELSEIF HOTPATCH_RELATIONSHIP_STATE(nChara) == 1
	sState '= "engaged"
ELSEIF TALENT:nChara:恋人 || TALENT:nChara:恋慕
	sState '= "love"
	SIF !TALENT:nChara:恋人
		sLabel '= "In love"
ELSEIF TALENT:nChara:セフレ
	sState '= "casual"
ELSEIF HOTPATCH_RELATIONSHIP_STATE(nChara) == -2
	sState '= "divorced"
	sLabel '= "Divorced"
ELSEIF HOTPATCH_FRIENDSHIP_ACTIVE(nChara)
	sState '= "friends"
ENDIF
SIF sState == "none"
	RETURNF ""
RETURNF @"<span class='era-relationship-icon era-relationship-icon-%sState%' title='%sLabel%'><span class='era-relationship-icon-label'>%sLabel%</span></span>"

@HOTPATCH_RELATIONSHIP_VISIBLE(nAction, nChara)
#FUNCTION
#DIM DYNAMIC nAction
#DIM DYNAMIC nChara
SELECTCASE nAction
CASE 1
	RETURNF !TALENT:nChara:恋人
CASE 2
	RETURNF !TALENT:nChara:セフレ && HOTPATCH_RELATIONSHIP_STATE(nChara) <= 0
CASE 3
	RETURNF HOTPATCH_RELATIONSHIP_STATE(nChara) <= 0
CASE 4, 5
	RETURNF HOTPATCH_RELATIONSHIP_STATE(nChara) == 1
CASE 6
	RETURNF TALENT:nChara:恋人
CASE 7
	RETURNF TALENT:nChara:セフレ
CASE 8
	RETURNF !HOTPATCH_FRIENDSHIP_ACTIVE(nChara)
CASE 9
	RETURNF TALENT:nChara:恋人 != 0
ENDSELECT
RETURNF 1

@HOTPATCH_RELATIONSHIP_FLAGS(nChara)
#FUNCTIONS
#DIM DYNAMIC nChara
#DIMS DYNAMIC sFlags
SIF TALENT:nChara:恋慕
	sFlags += "<span class='era-relationship-flag era-relationship-flag-love'>In love</span>"
SIF TALENT:nChara:恋人
	sFlags += "<span class='era-relationship-flag era-relationship-flag-lovers'>Lovers</span>"
SIF TALENT:nChara:セフレ
	sFlags += "<span class='era-relationship-flag era-relationship-flag-fwb'>FWB</span>"
SELECTCASE HOTPATCH_RELATIONSHIP_STATE(nChara)
CASE 1
	sFlags += "<span class='era-relationship-flag era-relationship-flag-engaged'>Engaged</span>"
CASE 2
	sFlags += "<span class='era-relationship-flag era-relationship-flag-married'>Married</span>"
CASE -1
	sFlags += "<span class='era-relationship-flag era-relationship-flag-ended'>Former engagement</span>"
CASE -2
	sFlags += "<span class='era-relationship-flag era-relationship-flag-ended'>Divorced</span>"
ENDSELECT
RETURNF sFlags

; Transient routing, never saved in game arrays. -1 consumes the pending action.
@HOTPATCH_RELATIONSHIP_REQUEST(nAction = -1)
#FUNCTION
#DIM DYNAMIC nAction
#DIM nPending
#DIM DYNAMIC nResult
IF nAction >= 0
	nPending = nAction
	RETURNF nPending
ENDIF
nResult = nPending
nPending = 0
RETURNF nResult

@HOTPATCH_RELATIONSHIP_CONFIRM(nSet = -1)
#FUNCTION
#DIM DYNAMIC nSet
#DIM nPending
#DIM DYNAMIC nResult
IF nSet >= 0
	nPending = nSet
	RETURNF nPending
ENDIF
nResult = nPending
nPending = 0
RETURNF nResult

@HOTPATCH_RELATIONSHIP_REASON(nAction, nChara)
#FUNCTIONS
#DIM DYNAMIC nAction
#DIM DYNAMIC nChara
SIF !INRANGE(nAction, 1, 9)
	RETURNF "Unknown relationship action."
SIF nChara == MASTER
	RETURNF "Choose another character to discuss a relationship."
SIF CFLAG:nChara:現在位置 != CFLAG:MASTER:現在位置
	RETURNF "They are not here."
SIF !TFLAG:100
	RETURNF "Finish the current encounter before discussing your relationship."
SIF FLAG:70
	RETURNF "Resume time before discussing your relationship."
SIF TFLAG:妄想中 == 1
	RETURNF "A daydream cannot change your real relationship."
SIF TFLAG:102 != 1
	RETURNF "Finish the current intimate scene before discussing your relationship."
SIF nAction != 8 && GET_TARGETNUM() > 1
	RETURNF "Find a private moment together first."
SIF CFLAG:nChara:睡眠
	RETURNF "They are asleep."
SIF CFLAG:nChara:添い寝中
	RETURNF "Get up from sleeping together first."
SIF nAction != 8 && TALENT:nChara:行きずり
	RETURNF "This character cannot form a lasting relationship."
SIF BASE:MASTER:気力 <= 0
	RETURNF "You do not have enough energy for this conversation."
IF nAction == 1
	SIF TALENT:nChara:恋人
		RETURNF "You are already lovers."
	SIF GETBIT(TFLAG:一日一回, 12)
		RETURNF "You have already confessed today."
	SIF !CAN_MAKE_恋人()
		RETURNF "You have reached your current lover limit."
ENDIF
IF GROUPMATCH(nAction, 1, 2, 3) && FLAG:甲斐性無 && !FLAG:LUSTMODE
	RETURNF "You cannot find the courage to make this proposition."
ENDIF
IF nAction == 2
	SIF HOTPATCH_RELATIONSHIP_STATE(nChara) > 0
		RETURNF "End the engagement or marriage before suggesting FWB."
	SIF TALENT:nChara:セフレ
		RETURNF "You already have a friends-with-benefits agreement."
	SIF CFLAG:nChara:好感度 < 500
		RETURNF "You need to be friends first."
ENDIF
IF GROUPMATCH(nAction, 3, 4, 5, 6) && !TALENT:nChara:恋人
	RETURNF "You need to be lovers first."
ENDIF
SIF nAction == 9 && !TALENT:nChara:恋人
	RETURNF "You need to be lovers first."
SIF nAction == 3 && HOTPATCH_RELATIONSHIP_STATE(nChara) > 0
	RETURNF "You are already engaged or married."
SIF nAction == 4 && HOTPATCH_RELATIONSHIP_STATE(nChara) != 1
	RETURNF "You need to be engaged first."
SIF nAction == 5 && HOTPATCH_RELATIONSHIP_STATE(nChara) != 1
	RETURNF "There is no engagement to end."
SIF nAction == 7 && !TALENT:nChara:セフレ
	RETURNF "There is no friends-with-benefits agreement to end."
RETURNF ""

@HOTPATCH_RELATIONSHIP_ACTION_NAME(nAction)
#FUNCTIONS
#DIM DYNAMIC nAction
SELECTCASE nAction
CASE 1
	RETURNF "Confess"
CASE 2
	RETURNF "FWB"
CASE 3
	RETURNF "Propose"
CASE 4
	RETURNF "Get married"
CASE 5
	RETURNF "End the engagement"
CASE 6
	SIF HOTPATCH_RELATIONSHIP_STATE(TARGET) == 2
		RETURNF "Ask for a divorce"
	RETURNF "End the romantic relationship"
CASE 7
	RETURNF "End FWB"
CASE 8
	RETURNF "Ask to be friends"
CASE 9
	RETURNF "Reaffirm your love"
ENDSELECT
RETURNF ""

@HOTPATCH_RELATIONSHIP_DIALOG(nPreview = 0)
#DIM DYNAMIC nPreview
#DIM DYNAMIC nStart
#DIM DYNAMIC nAction
#DIMS DYNAMIC sReason
#DIMS DYNAMIC sError
nStart = LINECOUNT
DO
	CLEARLINE LINECOUNT - nStart
	HTML_PRINT "<era-open class='era-dialog era-relationship'>"
	SIF nPreview
		CALL DEMO_RELATIONSHIP_CONTROLS
	CALL HOTPATCH_FACE(TARGET, 90)
	HTML_PRINT @"<div class='era-relationship-header'><span class='era-info-face'>%RESULTS%</span>%HOTPATCH_RELATIONSHIP_ICON(TARGET)%<div><span class='era-sub'>Your relationship with</span><h2 class='era-relationship-heading'>%HTML_ESCAPE(CALLNAME:TARGET)%</h2></div><button value='999' class='era-dialog-close' title='Close relationship dialog'>×</button></div>"
	HTML_PRINT "<era-open class='era-relationship-body'>"
	HTML_PRINT @"<div class='era-relationship-timeline' data-favor='{CFLAG:TARGET:好感度}' data-intimacy='{ABL:TARGET:親密}' data-lover='{TALENT:TARGET:恋人 != 0}' data-in-love='{TALENT:TARGET:恋慕 != 0}' data-casual='{TALENT:TARGET:セフレ != 0}' data-commitment='{HOTPATCH_RELATIONSHIP_STATE(TARGET)}'></div>"
	HTML_PRINT @"<div class='era-relationship-summary'><span>Favor <b>{CFLAG:TARGET:好感度}</b></span><span>Trust <b>{CFLAG:TARGET:信頼度}</b></span><span>Intimacy <b>{ABL:TARGET:親密}</b></span><span>Love exp <b>{EXP:TARGET:愛情経験}</b></span>%HOTPATCH_RELATIONSHIP_FLAGS(TARGET)%</div>"
	IF STRLENS(sError)
		HTML_PRINT @"<p class='era-relationship-error' role='alert'>%HTML_ESCAPE(sError)%</p>"
	ENDIF
	HTML_PRINT "<era-open class='era-relationship-options'>"
	FOR nAction, 1, 10
		SIF !HOTPATCH_RELATIONSHIP_VISIBLE(nAction, TARGET)
			CONTINUE
		sReason '= HOTPATCH_RELATIONSHIP_REASON(nAction, TARGET)
		HTML_PRINT @"<era-open class='era-relationship-option era-relationship-action-{nAction}%(INRANGE(nAction, 5, 7) ? " era-relationship-downgrade" # "")%'>"
		IF STRLENS(sReason)
			HTML_PRINT @"<h3 class='era-relationship-option-title'><button disabled class='era-relationship-select'>%HOTPATCH_RELATIONSHIP_ACTION_NAME(nAction)%</button></h3><span class='era-relationship-reason'>Unavailable</span><span class='era-relationship-reason'>%HTML_ESCAPE(sReason)%</span>"
		ELSE
			HTML_PRINT @"<h3 class='era-relationship-option-title'><button value='{nAction}' class='era-relationship-select'>%HOTPATCH_RELATIONSHIP_ACTION_NAME(nAction)%</button></h3>"
		ENDIF
		HTML_PRINT "<era-close>"
	NEXT
	HTML_PRINT "<era-close>"
	HTML_PRINT "<era-close>"
	HTML_PRINT "<div class='era-relationship-footer'><button value='999' class='era-chip-button'>Close</button></div>"
	HTML_PRINT "<era-close>"
	INPUT
	sError '= ""
	SELECTCASE RESULT
	CASE 101 TO 116
		IF nPreview
			nAction = RESULT
			CLEARLINE LINECOUNT - nStart
			RETURN nAction
		ENDIF
		sError '= "Choose a relationship conversation, or close the dialog."
	CASE 999
		CLEARLINE LINECOUNT - nStart
		RETURN 0
	CASE 1 TO 9
		nAction = RESULT
		IF HOTPATCH_RELATIONSHIP_VISIBLE(nAction, TARGET)
			sReason '= HOTPATCH_RELATIONSHIP_REASON(nAction, TARGET)
			IF !STRLENS(sReason)
				CLEARLINE LINECOUNT - nStart
				RETURN nAction
			ENDIF
			sError '= sReason
		ELSE
			sError '= "Choose a relationship conversation first."
		ENDIF
	CASEELSE
		sError '= "Choose a relationship conversation, or close the dialog."
	ENDSELECT
LOOP 1

@USERCOM
#DIM DYNAMIC nInput
#DIM DYNAMIC nAction
#DIM DYNAMIC nCommand
#DIMS DYNAMIC sReason
nInput = RESULT
CALL HOTPATCH_RELATIONSHIP_CONFIRM(0)
CALL HOTPATCH_CONFESSION_FLOW(0)
RESULT = nInput
IF !GROUPMATCH(nInput, 352, 357)
	JUMP HOTPATCH_ORIGINAL_USERCOM
ENDIF
nAction = HOTPATCH_RELATIONSHIP_REQUEST()
IF !nAction
	CALL HOTPATCH_RELATIONSHIP_DIALOG
	nAction = RESULT
ENDIF
SIF !nAction
	RETURN 0
sReason '= HOTPATCH_RELATIONSHIP_REASON(nAction, TARGET)
IF STRLENS(sReason)
	PRINTFORML Relationship unchanged: %sReason%
	RETURN 0
ENDIF
IF nAction == 8
	CALL HOTPATCH_RELATIONSHIP_CHANGE(nAction)
	RETURN 0
ENDIF
nCommand = nAction == 9 ? 311 # nAction == 2 ? 357 # 352
IF GLOBAL_COMABLE2(nCommand)
	PRINTL Relationship unchanged: this conversation is blocked by the current encounter rules.
	RETURN 0
ENDIF
CALL KOJO_CHECK(TARGET, "COM_BLOCKED",,nCommand)
IF RESULT
	PRINTL Relationship unchanged: this character's current story blocks this conversation.
	RETURN 0
ENDIF
IF nAction >= 3 && nAction != 9
	CALL HOTPATCH_RELATIONSHIP_CHANGE(nAction, INRANGE(nAction, 3, 7))
	RETURN 0
ENDIF
IF nAction == 9
	CALL COM_ABLE311
	IF !RESULT
		PRINTL You cannot share a hug right now.
		RETURN 0
	ENDIF
	PRINTFORML You remind %CALLNAME:TARGET% that you love them and reach out for a hug.
ELSEIF nAction == 1
	CALL HOTPATCH_CONFESSION_CONFIRM
	SIF !RESULT
		RETURN 0
	CALL HOTPATCH_CONFESSION_FLOW(1)
	CALL HOTPATCH_RELATIONSHIP_CONFIRM(1)
ELSE
	CALL HOTPATCH_RELATIONSHIP_CONFIRM(1)
ENDIF
RESULT = nCommand
CALL HOTPATCH_ORIGINAL_USERCOM
RETURN RESULT

