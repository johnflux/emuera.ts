nState = HOTPATCH_RELATIONSHIP_STATE(TARGET)
SELECTCASE nAction
CASE 8
	TIME += 10
	PRINTFORML Friendship check: %HOTPATCH_FRIENDSHIP_DETAILS(TARGET)%
	sReason '= HOTPATCH_FRIENDSHIP_REASON(TARGET)
	IF STRLENS(sReason)
		PRINTFORML Friendship declined: %sReason%
		RETURN 0
	ENDIF
	CALL HOTPATCH_FRIENDSHIP_ACCEPT(TARGET)
CASE 3
	TIME += 10
	IF EXP:TARGET:愛情経験 <= 250 + TALENT:TARGET:一線越えない * 100
		PRINTFORML Proposal declined: love experience ({EXP:TARGET:愛情経験}) must be above {250 + TALENT:TARGET:一線越えない * 100}. You remain lovers.
		RETURN 0
	ENDIF
	IF BASE:TARGET:怒り > 0 || CFLAG:TARGET:不機嫌 || MARK:TARGET:反発刻印
		PRINTL Proposal declined: resolve their anger and resentment first. You remain lovers.
		RETURN 0
	ENDIF
	CFLAG:TARGET:7398 = 1
	PRINTFORML You ask %CALLNAME:TARGET% to marry you. They accept: you are now engaged.
CASE 4
	TIME += 10
	IF BASE:TARGET:怒り > 0 || CFLAG:TARGET:不機嫌 || MARK:TARGET:反発刻印
		PRINTL Marriage declined: resolve their anger and resentment first. You remain engaged.
		RETURN 0
	ENDIF
	CFLAG:TARGET:7398 = 2
	PRINTFORML You and %CALLNAME:TARGET% confirm your marriage. You are now married.
CASE 5
	CFLAG:TARGET:7398 = -1
	TIME += 10
	PRINTFORML You and %CALLNAME:TARGET% end your engagement. You remain lovers; your feelings are unchanged.
CASE 6
	TALENT:TARGET:恋人 = 0
	CFLAG:TARGET:7398 = nState == 2 ? -2 # nState == 1 ? -1 # MIN(nState, 0)
	CLEARBIT CFLAG:TARGET:既成事実, 2
	IF TALENT:MASTER:恋人 == NO:TARGET
		TALENT:MASTER:恋人 = 0
		FOR nIndex, 0, CHARANUM
			IF nIndex != MASTER && TALENT:nIndex:恋人
				TALENT:MASTER:恋人 = NO:nIndex
				BREAK
			ENDIF
		NEXT
	ENDIF
	SIF !TALENT:MASTER:恋人
		CLEARBIT CFLAG:MASTER:既成事実, 2
	TIME += 10
	IF nState == 2
		PRINTFORML You and %CALLNAME:TARGET% divorce. Formal commitment has ended; affection, trust and other feelings are preserved.
	ELSE
		PRINTFORML You and %CALLNAME:TARGET% stop being lovers. Affection, trust and other feelings are preserved.
	ENDIF
CASE 7
	SIF TALENT:TARGET:セフレ == 2
		TALENT:TARGET:思慕 = 1
	TALENT:TARGET:セフレ = 0
	CFLAG:TARGET:契約セフレ = 0
	TIME += 10
	PRINTFORML You and %CALLNAME:TARGET% end your friends-with-benefits agreement. Other feelings are preserved.
ENDSELECT
RETURN 1
