IF (ARGS:0 == "No" && ARGS:1 == "Confess") || (ARGS:0 == "Cancel" && ARGS:1 == "Make proposition")
	SIF HOTPATCH_RELATIONSHIP_CONFIRM()
		RETURN 1
ENDIF
JUMP HOTPATCH_ORIGINAL_ASK_YN(ARGS:0, ARGS:1)

