@AI_CONFIG_MENU
#DIMS DYNAMIC curProvider
#DIMS DYNAMIC curModel
#DIMS DYNAMIC ctxLabel
#DIM DYNAMIC configured
#DIM DYNAMIC online
$CONFIG_START
CALL AI_OPTS_ENSURE
CALL AI_CONFIG_CMD("GET_CONFIG", "", "", "", 2000)
online = RESULT == 1 && AI_KV_GET("STATUS", "") == "OK"
curProvider '= AI_KV_GET("PROVIDER", "app")
curModel '= AI_KV_GET("ACTIVE_MODEL", "(not configured)")
ctxLabel '= AI_KV_GET("CTX_LABEL", "")
configured = online && AI_KV_GETI("HAS_KEY")

CUSTOMDRAWLINE ━
ALIGNMENT CENTER
SETCOLOR C_AQUA
PRINTL ★ EraTohoTW AI Settings & API Key Setup ★
RESETCOLOR
ALIGNMENT LEFT
CUSTOMDRAWLINE ━
PRINTFORM  Bridge Status:
IF online
	SETCOLOR C_GREEN
	PRINTL Using Emuera.ts
ELSE
	SETCOLOR C_RED
	PRINTFORML %AI_KV_GET("MESSAGE", "No response from the embedded AI bridge.")%
ENDIF
RESETCOLOR
PRINTFORM  Active Provider:
SETCOLOR C_GREEN
SELECTCASE curProvider
	CASE "openrouter"
		PRINTL OpenRouter
	CASE "openai"
		PRINTL OpenAI
	CASE "local"
		PRINTL Local (OpenAI-compatible)
	CASEELSE
		PRINTL Not configured
ENDSELECT
RESETCOLOR
PRINTFORML  Active Model: %curModel%
PRINTFORM  API Key:
IF configured && curProvider == "local"
	PRINTL Optional for local providers
ELSEIF configured
	PRINTL Configured in Emuera.ts
ELSE
	PRINTL Not configured in Emuera.ts
ENDIF
CUSTOMDRAWLINE ─
HTML_PRINT "<button data-app-action='llm-settings'>LLM Settings</button><br>"
PRINTL  [ 2] Test Connection
PRINTL  [ 4] Lorebooks (turn hard lorebooks on/off, status)
CUSTOMDRAWLINE ─
PRINTFORML  [ 5] Reactions after commands: %AI_OPT_NAME_REACT()%
PRINTFORML  [ 6] Commands that get reactions: %AI_OPT_NAME_SCOPE()%
PRINTFORML  [ 7] Reaction chance: {AI_OPT_REACT_CHANCE_PCT()}\%
PRINTFORML  [ 8] First-meeting greetings: %AI_OPT_NAME_GREET()%
PRINTL  [ 9] Character descriptions (view / edit / regenerate)
PRINTFORML  [10] Nearby characters chime in on AI chats: %AI_OPT_NAME_CHIME()%
CUSTOMDRAWLINE ─
IF online
	PRINTFORML  [11] Context budget: %ctxLabel%
ELSE
	PRINTL  [11] Context budget (bridge offline)
ENDIF
PRINTFORML  [12] Memory source (this save): %AI_MEM_SOURCE_NAME()%
PRINTL  [13] AI summaries (summarize pending days, resummarize, monthly summaries)
PRINTL
PRINTL  [99] Return
CUSTOMDRAWLINE ━
$INPUT_LOOP
INPUT
SELECTCASE RESULT
	CASE 2
		DRAWLINE
		SETCOLOR C_AQUA
		PRINTL Testing connection... Please wait.
		RESETCOLOR
		CALL AI_CONFIG_CMD("TEST_CONNECTION", "", "", "", 30000)
		IF RESULT == 1
			CALL AI_CONFIG_SHOW_RESULT
		ELSE
			PRINTFORMW Error: No response from the embedded AI bridge.
		ENDIF
	CASE 14
		; Refresh after closing the app's LLM settings dialog.
		GOTO CONFIG_START
	CASE 4
		CALL AI_LORE_MENU
	CASE 5
		AI_OPT_REACT = (AI_OPT_REACT + 1) % 3
		SAVEGLOBAL
	CASE 6
		AI_OPT_REACT_SCOPE = !AI_OPT_REACT_SCOPE
		SAVEGLOBAL
	CASE 7
		SELECTCASE AI_OPT_REACT_CHANCE_PCT()
			CASE 100
				AI_OPT_REACT_CHANCE = 75
			CASE 75
				AI_OPT_REACT_CHANCE = 50
			CASE 50
				AI_OPT_REACT_CHANCE = 25
			CASEELSE
				AI_OPT_REACT_CHANCE = 100
		ENDSELECT
		SAVEGLOBAL
	CASE 8
		AI_OPT_GREET = (AI_OPT_GREET + 1) % 4
		SAVEGLOBAL
	CASE 9
		CALL AI_DESC_LIST_MENU
	CASE 10
		AI_OPT_CHIME = (AI_OPT_CHIME + 1) % 3
		SAVEGLOBAL
	CASE 11
		CALL AI_CONTEXT_MENU
	CASE 12
		CALL AI_MEMSRC_MENU
	CASE 13
		CALL AI_SUM_TOOLS_MENU
	CASE 99
		RETURN 0
	CASEELSE
		CLEARLINE 1
		GOTO INPUT_LOOP
ENDSELECT
GOTO CONFIG_START
