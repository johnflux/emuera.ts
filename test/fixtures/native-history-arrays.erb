@SYSTEM_TITLE
ADDVOIDCHARA
ADDVOIDCHARA
TARGET = 1
FOR A,0,5
CALL PROBE
NEXT
PRINTL DONE
OUTPUTLOG
QUIT

@PROBE
#DIM GRID,2,4
#DIM VALUES,4
#DIM CUBE,2,2,3
#DIMS WORDS,2,3
VARSET GRID
VARSET VALUES
VARSETEX "VALUES:2",7,0,0,4
PRINTFORML VECTOR {VALUES:0} {VALUES:1} {VALUES:2} {VALUES:3}
PRINTFORML SET {VARSETEX("GRID:1:2",9,1,1,4)}
PRINTFORML GRID {GRID:0:0} {GRID:0:1} {GRID:0:2} {GRID:1:2}
VARSETEX "WORDS:1:1","x",1,0,3
PRINTFORML WORDS [%WORDS:0:1%] [%WORDS:1:1%] [%WORDS:1:2%]
RESULT = 88
LOCAL = VARSETEX("VALUES",3,0,1,3)
PRINTFORML RESULT {LOCAL} {RESULT} {VALUES:0} {VALUES:1} {VALUES:2} {VALUES:3}
VARSETEX "VALUES:999",4,0,0,4
PRINTFORML IGNORED {VALUES:0} {VALUES:3}
VARSETEX "CUBE:1:1:1",7,1,0,3
PRINTFORML CUBE {CUBE:0:0:0} {CUBE:0:0:1} {CUBE:0:1:1} {CUBE:1:0:1} {CUBE:1:1:1}
VARSETEX "CFLAG:2",8
PRINTFORML CHARA {CFLAG:0:2} {CFLAG:1:0} {CFLAG:1:1} {CFLAG:1:2}
VARSETEX "CFLAG:1:2",6
PRINTFORML EXPLICIT {CFLAG:0:1} {CFLAG:0:2} {CFLAG:1:1} {CFLAG:1:2} {CFLAG:1:3}
VARSETEX "CFLAG",0
RETURN
