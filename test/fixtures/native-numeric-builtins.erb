@SYSTEM_TITLE
FOR A, 0, 5
CALL PROBE
NEXT
PRINTL DONE
OUTPUTLOG
QUIT

@PROBE
PRINTFORML INVALID {ISNUMERIC("0x")} {ISNUMERIC("0b")} {ISNUMERIC("4e")} {ISNUMERIC("4p")} {ISNUMERIC("")} {ISNUMERIC("abc")}
PRINTFORML SIGNS {ISNUMERIC("+7")} {ISNUMERIC("-7")} {ISNUMERIC("3e-1")} {ISNUMERIC("3e+2")} {ISNUMERIC("-0x1")}
PRINTFORML DECIMAL {TOINT("+7")} {TOINT("-7")} {TOINT("3e2")} {TOINT("3p2")} {TOINT("4e+2")} {TOINT("10e-1")}
PRINTFORML BASES {TOINT("0x10")} {TOINT("0b101")} {TOINT("0b10e10")} {TOINT("0x2p10")}
PRINTFORML FRACTIONS {ISNUMERIC("1.")} {ISNUMERIC("12.75")} {ISNUMERIC("1.5e2")} {ISNUMERIC("1e2.75")} {TOINT("1e2.75")}
PRINTFORML LIMITS {TOINT("9223372036854775807")} {TOINT("-9223372036854775808")} {TOINT("0xffffffffffffffff")} {TOINT("0x8000000000000000")}
PRINTFORML ZERO {TOINT("0e99")} {TOINT("abc")} {TOINT("")} {TOINT("4f")} {TOINT("0x")} {TOINT("0b")}
RETURN
