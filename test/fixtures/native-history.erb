@SYSTEM_TITLE
FOR A, 0, 5
CALL PROBE
NEXT
PRINTL DONE
OUTPUTLOG
QUIT

@PROBE
#DIMS ROW
#DIMS VARS
ROW = a;b;c
VARS = hello
LOCAL = 0
SETBIT OTHERBITS
PRINTFORML TEXT [%ROW%] [%VARS%]
PRINTFORML BITS {GETBIT(BITS)} {LOCAL}
PRINTFORML DEFAULTS {EJAC} {GAMEBASE_GAMECODE}
PRINTFORML DEFINED {ISDEFINED("PRESENT")} {ISDEFINED("FLAG")}
PRINTCPERLINE LOCAL:2
PRINTFORML PRINTC {LOCAL:2} {PRINTCPERLINE()}
LOCAL = 2
TRYCALLLIST
FUNC MISSING
FUNC PICK{LOCAL}, 7
FUNC WRONG
ENDFUNC
PRINTFORML LIST {RESULT}
RETURN

@PICK2(ARG)
RETURN ARG + 35

@WRONG
THROW "must not run a later entry"
