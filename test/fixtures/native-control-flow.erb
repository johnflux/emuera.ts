@SYSTEM_TITLE
OUTPUTLOG
FOR A, 0, 5
CALL PROBE
NEXT
PRINTL DONE
OUTPUTLOG
QUIT

@PROBE
FLAG:9 = 0
LOCAL = 0 !& SIDE()
LOCAL:1 = 1 !| SIDE()
LOCAL:2 = 1 ^^ SIDE()
PRINTFORML SHORT {LOCAL} {LOCAL:1} {LOCAL:2} {FLAG:9}
LOCAL = 1 !& SIDE()
LOCAL:1 = 0 !| SIDE()
PRINTFORML EVAL {LOCAL} {LOCAL:1} {FLAG:9}
RESULT = 88
RESULT:1 = 77
CALL FALL
PRINTFORML FALL {RESULT} {RESULT:1}
RESULT = 88
LOCAL = FUN()
PRINTFORML FUN {LOCAL} {RESULT}
FOR LOCAL, 0, 9
BREAK
NEXT
FOR LOCAL:1, 9, 0, -2
BREAK
NEXT
REPEAT 9
BREAK
REND
PRINTFORML BREAK {LOCAL} {LOCAL:1} {COUNT}
FOR LOCAL, 0, 5
SIF LOCAL == 4
BREAK
NEXT
PRINTFORML BREAK_LAST {LOCAL}
CALL WAGER(1)
CALL WAGER(3)
PRINTFORML TRAIL_EXPR {ONE(8,)} {TWO(8,,)} {TWO(8,)}
CALL TAKE, 8,
PRINTFORML TRAIL_CALL {RESULT}
LOCAL = 0
REPEAT 2,
LOCAL += 1
REND
PRINTFORML TRAIL_REPEAT {LOCAL}
LOCAL = 9
LOCAL:0,-= 2
LOCAL:1 == 6
PRINTFORML ASSIGN {LOCAL} {LOCAL:1}
PRINTFORML DEFAULT {GAMEBASE_DEFAULTCHARA}
RETURN

@SIDE
#FUNCTION
FLAG:9 += 1
RETURNF 1

@FALL
LOCAL = 1

@FUN
#FUNCTION
CALLF EMPTYFUN
RETURNF 3

@EMPTYFUN
#FUNCTION
LOCAL = 1

@ONE(ARG)
#FUNCTION
RETURNF ARG

@TWO(ARG, ARG:1 = 5)
#FUNCTION
RETURNF ARG + ARG:1

@TAKE(ARG)
RETURN ARG

@WAGER(ARG)
#DIMS BETS, 20
IF ARG == 1
SPLIT "NONE/", "/", BETS
ELSE
SPLIT "NONE/MONEY/CHARISMA/", "/", BETS
ENDIF
FOR LOCAL, 0, 20
SIF !STRLENS(BETS:LOCAL)
BREAK
NEXT
PRINTFORML WAGER {ARG} {LOCAL}
FOR LOCAL:1, -1, ARG + 1
SIF LOCAL:1 >= 0 && LOCAL:1 < LOCAL-1
PRINTFORML BET {LOCAL:1} %BETS:(LOCAL:1)%
NEXT
RETURN
