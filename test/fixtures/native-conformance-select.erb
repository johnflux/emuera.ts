@SYSTEM_TITLE
FOR A,0,45
PRINTFORML RANGE {CLASSIFY("apple")} {CLASSIFY("banana")} {CLASSIFY("blueberry")} {CLASSIFY("cherry")} {CLASSIFY("date")} {CLASSIFY("zebra")}
PRINTFORML EQUAL {BOUNDARY("banana")} {BOUNDARY("cherry")} {BOUNDARY("date")}
PRINTFORML REVERSE {REVERSED("banana")}
NEXT
PRINTL DONE
OUTPUTLOG
QUIT
@CLASSIFY(Word)
#FUNCTION
#DIMS Word
SELECTCASE Word
CASE "apple"
RETURNF 1
CASE "banana" TO "cherry"
RETURNF 2
CASE IS > "yellow"
RETURNF 3
CASEELSE
RETURNF 4
ENDSELECT
@BOUNDARY(Word)
#FUNCTION
#DIMS Word
SELECTCASE Word
CASE IS >= "cherry"
RETURNF 1
CASE IS <= "banana"
RETURNF 2
CASEELSE
RETURNF 3
ENDSELECT
@REVERSED(Word)
#FUNCTION
#DIMS Word
SELECTCASE Word
CASE "cherry" TO "banana"
RETURNF 1
CASEELSE
RETURNF 2
ENDSELECT
