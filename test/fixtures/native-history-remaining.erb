@SYSTEM_TITLE
#DIM ProbePrivate
#DIMS Substitutes,2 = "$1","second"
ADDVOIDCHARA
CDFLAG:0:1:2 = 42
PRINTFORML CDFLAG {VARSIZE("CDFLAG",0)} {VARSIZE("CDFLAG",1)} {CDFLAG:0:1:2}
PRINTFORML ENUMV {ENUMVARBEGINSWITH("Probe")} [%RESULTS:0%] [%RESULTS:1%]
PRINTFORML ENUMM {ENUMMACROBEGINSWITH("Probe")} [%RESULTS:0%] [%RESULTS:1%]
TRYCGOTO MISSING
PRINTL CONSTANT_BRANCH
CATCH
PRINTL CONSTANT_CATCH
ENDCATCH
TRYCGOTOFORM MISSING
PRINTL DYNAMIC_BRANCH
CATCH
PRINTL DYNAMIC_CATCH
ENDCATCH
GLOBAL = 8
NativeInitial = 4
RESETGLOBAL
PRINTFORML RESET {GLOBAL} {NativeInitial}
CUP:0:1 = 7
CUPCHECK 0
PRINTFORML CUP {PALAM:0:1} {CUP:0:1}
PRINTSL REPLACE("a.b.c",".","-",2)
PRINTSL REPLACE("a1b2c3","[0-9]",Substitutes,1)
LOCAL = 1
PRINTSL REPLACE("a.b",".","-",LOCAL++)
PRINTFORML MODE {LOCAL}
PRINTSL TOSTR(7," 000;-000")
PRINTSL TOSTR(-7," 000;-000")
PRINTSL TOSTR(-1,"0,;(0,);zero")
SETANIMETIMER 0
PRINTFORML TIMER {RESULT}
PRINTL DONE
OUTPUTLOG
QUIT
