{
  "name": "era-typescript",
  "version": "0.1.18",
  "description": "A browser-based interpreter for Emuera/ERB games.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@napi-rs/image": "^1.16.0",
    "@xmldom/xmldom": "^0.9.12",
    "parse5": "^8.0.0",
    "xpath": "^0.0.35",
    "yauzl": "^3.4.0"
  },
  "scripts": {
    "dev": "npm run build:css && concurrently --kill-others \"npm:watch:css\" \"npm:watch:server\"",
    "watch:css": "sass --watch --no-source-map styles:web/generated",
    "watch:server": "tsx watch --clear-screen=false --include 'web/**' --include 'hotpatch/**' --include 'GAMES/*/{[eE][rR][bB],[cC][sS][vV],[rR][eE][sS][oO][uU][rR][cC][eE][sS]}/**' --include 'GAMES/*/*/{[eE][rR][bB],[cC][sS][vV],[rR][eE][sS][oO][uU][rR][cC][eE][sS]}/**' src/server.ts --dev",
    "build:css": "sass --no-source-map styles:web/generated",
    "build": "npm run build:css && tsc",
    "start": "npm run dev",
    "start:prod": "node dist/server.js",
    "desktop": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64",
    "dist:win": "npm run build && electron-builder --win zip --x64",
    "dist:linux": "npm run build && electron-builder --linux tar.gz --x64",
    "release": "npm version --message \"Release v%s\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>\"",
    "check": "tsc --noEmit",
    "pretest": "npm run build:css",
    "test": "tsx --test test/*.test.ts",
    "compat": "tsx src/compat.ts",
    "area-art": "tsx src/area-art.ts",
    "area-seasons": "tsx src/seasonal-art.ts"
  },
  "main": "electron/main.cjs",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "sass": "^1.93.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "org.emuera.era",
    "productName": "Era",
    "asar": true,
    "beforePack": "electron/before-pack.cjs",
    "files": [
      "dist/**/*",
      "web/**/*",
      "hotpatch/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/game-paths.cjs",
      "electron/steam-launch.cjs",
      "electron/update-check.cjs",
      "package.json",
      "!GAMES/**",
      "!test/**",
      "!docs/**",
      "!src/**"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "executableName": "emuera-ts",
      "artifactName": "EraTs-${version}-win-x64.${ext}",
      "target": [
        "zip"
      ]
    },
    "linux": {
      "executableName": "emuera-ts",
      "artifactName": "EraTs-${version}-linux-${arch}.${ext}",
      "category": "Game",
      "target": [
        "tar.gz"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
