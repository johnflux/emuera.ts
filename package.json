{
  "name": "era-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "parse5": "^8.0.0",
    "xpath": "^0.0.35"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include 'web/**' --include 'hotpatch/**' --include 'GAMES/*/ERB/**' --include 'GAMES/*/CSV/**' --include 'GAMES/*/resources/**' --include 'GAMES/*/*/ERB/**' --include 'GAMES/*/*/CSV/**' --include 'GAMES/*/*/resources/**' src/server.ts --dev",
    "build": "tsc",
    "start": "npm run dev",
    "start:prod": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "compat": "tsx src/compat.ts",
    "area-art": "tsx src/area-art.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
